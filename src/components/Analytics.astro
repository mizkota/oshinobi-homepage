---
// Google Analytics 4（GA4プロパティ「御忍庭球塾」/ oshinobitennis.com）
// 本番ドメインでのみ計測する（localhost・github.io のプレビューはカウントしない）
const GA_ID = 'G-D916L3MCWD';
---

<script is:inline define:vars={{ GA_ID }}>
  if (location.hostname === 'oshinobitennis.com' || location.hostname === 'www.oshinobitennis.com') {
    const tag = document.createElement('script');
    tag.async = true;
    tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
    document.head.appendChild(tag);

    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', GA_ID);
  }
</script>
