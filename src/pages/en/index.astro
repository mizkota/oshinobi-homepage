---
import LayoutEN from '../../layouts/LayoutEN.astro';
const base = import.meta.env.BASE_URL;
---

<LayoutEN title="Tennis Lessons in Sapporo, Hokkaido | Oshinobi Tennis Academy" description="Private tennis lessons in Sapporo, Hokkaido with an English-friendly Japanese coach. From ¥10,000 (60 min), indoor court open year-round, all equipment free. Beginners welcome.">

  <Fragment slot="head">
    <!-- Open Graph -->
    <meta property="og:title" content="Tennis Lessons in Sapporo, Hokkaido | Oshinobi Tennis Academy" />
    <meta property="og:description" content="Private tennis lessons in Sapporo, Hokkaido with an English-friendly Japanese coach. From ¥10,000 (60 min), indoor court open year-round, all equipment free. Beginners welcome." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://oshinobitennis.com/en/" />
    <meta property="og:site_name" content="Oshinobi Tennis Academy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://oshinobitennis.com/images/hero/court.jpg" />

    <!-- 構造化データ: SportsActivityLocation + Service + FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsActivityLocation",
      "name": "Oshinobi Tennis Academy",
      "description": "Private tennis lessons in Sapporo, Japan. Basic English supported — Japanese coach with conversational English. Personalized coaching for all levels from beginners to advanced players.",
      "url": "https://oshinobitennis.com/en/",
      "image": "https://oshinobitennis.com/images/hero/court.jpg",
      "priceRange": "¥10,000 - ¥16,500 per lesson (court rental separate)",
      "sport": "Tennis",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1-2-12-1 Yonesato, Shiroishi-ku",
        "addressLocality": "Sapporo",
        "addressRegion": "Hokkaido",
        "postalCode": "003-0871",
        "addressCountry": "JP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.0536,
        "longitude": 141.4078
      },
      "telephone": "+81-11-827-7171",
      "employee": {
        "@type": "Person",
        "name": "Kota Mizukami",
        "jobTitle": "Head Tennis Coach",
        "description": "Tennis coach in Sapporo with basic conversational English. YouTube channel with 7,500+ subscribers. Competed in national tournaments since junior years, specializes in doubles strategy.",
        "sameAs": "https://www.youtube.com/channel/UCKtgQuL9B0c8y42hHnx8JQQ"
      },
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "Indoor Court", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Free Equipment Rental", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Free Parking", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Basic English Supported", "value": true }
      ],
      "potentialAction": {
        "@type": "ReserveAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://lin.ee/2CKErIS",
          "actionPlatform": "http://schema.org/DesktopWebPlatform"
        },
        "description": "Contact us via LINE for pricing and availability"
      }
    })} />

    <!-- FAQ 構造化データ -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does the coach speak English?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Coach Kota speaks basic conversational English — enough to run a tennis lesson. He is not a fluent speaker, but tennis instructions, drills, and simple conversation are no problem. LINE replies are also in basic English."
          }
        },
        {
          "@type": "Question",
          "name": "Is the tennis lesson suitable for beginners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. All skill levels are welcome, from complete beginners to advanced players. Lessons are fully personalized to your level and goals."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to bring my own tennis equipment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, rackets and balls are provided for free. Just bring sportswear and indoor court shoes (clean soles). Shoes can also be rented at the venue."
          }
        },
        {
          "@type": "Question",
          "name": "Where are the tennis lessons held in Sapporo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lessons are held at PLACE OF SPORTS NEO, an indoor sports facility in Shiroishi-ku, Sapporo. The court is available year-round regardless of weather."
          }
        },
        {
          "@type": "Question",
          "name": "How do I book a tennis lesson in Sapporo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simply send a message via LINE (Japan's most popular messaging app), or use the booking form on our website — no LINE account needed. We'll reply in simple English to confirm your preferred date, time, and lesson duration."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a private tennis lesson in Sapporo cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "¥10,000 for 60 minutes, ¥13,000 for 90 minutes, or ¥16,500 for 120 minutes — per lesson, not per person (up to 2 players). Indoor court rental (¥4,400–¥6,600 per hour depending on season and time) is added; the coach arranges the court booking for you."
          }
        },
        {
          "@type": "Question",
          "name": "What is the cancellation policy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Free cancellation up to 7 days before your lesson. Within 7 days, message us and we'll do our best to reschedule. The court is fully indoors, so lessons are never cancelled due to weather."
          }
        }
      ]
    })} />
  </Fragment>

  <!-- ===== HERO ===== -->
  <section class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img src={`${base}images/hero/court.jpg`} alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-navy-950/85 via-primary-dark/40 to-navy-950/90"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 md:px-6 py-32 w-full">
      <div class="max-w-3xl">
        <p class="text-accent font-display font-semibold tracking-[0.3em] text-xs md:text-sm mb-6">PRIVATE TENNIS LESSONS &mdash; SAPPORO, HOKKAIDO</p>
        <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] font-black font-display text-white mb-8 leading-[1.1] tracking-tight">
          Play Tennis<br />in Sapporo
        </h1>
        <div class="w-16 h-0.5 bg-accent mb-8"></div>
        <p class="text-lg md:text-xl text-white/80 leading-relaxed mb-4 max-w-lg">
          Private lessons with a local Japanese coach<br />
          (basic English OK) &mdash; for travelers &amp; residents
        </p>
        <p class="text-base text-white/60 leading-relaxed mb-8 max-w-lg">
          All levels welcome &mdash; beginners to advanced
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2 mb-12 text-sm text-white/80 font-medium">
          <span class="flex items-center gap-2"><span class="text-accent">&#10003;</span> From &yen;10,000 / lesson</span>
          <span class="flex items-center gap-2"><span class="text-accent">&#10003;</span> Indoor &mdash; snow or shine</span>
          <span class="flex items-center gap-2"><span class="text-accent">&#10003;</span> Free rackets &amp; balls</span>
          <span class="flex items-center gap-2"><span class="text-accent">&#10003;</span> YouTube coach &mdash; 7,500+ subscribers</span>
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#booking" class="rounded-full bg-accent text-primary-dark hover:bg-accent-light font-bold px-10 py-4 transition-all duration-300 text-center tracking-wider shadow-lg shadow-accent/20 hover:-translate-y-0.5">
            Check Availability
          </a>
          <a href="#pricing" class="rounded-full border-2 border-white/60 text-white hover:bg-white hover:text-primary-dark font-bold px-10 py-4 transition-all duration-300 text-center tracking-wider">
            See Pricing
          </a>
        </div>
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50">
      <span class="text-xs tracking-[0.2em] font-display">SCROLL</span>
      <div class="w-px h-10 bg-white/30 animate-pulse"></div>
    </div>
  </section>

  <!-- ===== ABOUT COACH ===== -->
  <section id="coach" class="relative py-24 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-primary-dark to-primary"></div>
    <p class="absolute top-8 left-4 md:left-12 text-[5rem] md:text-[10rem] font-black font-display text-white/[0.03] leading-none tracking-tight select-none">COACH</p>
    <div class="relative max-w-6xl mx-auto px-4 md:px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="aspect-[4/3] overflow-hidden rounded-2xl shadow-2xl shadow-navy-950/50">
          <img src={`${base}images/en/coach_kota.jpg`} alt="Coach Kota Mizukami on court" class="w-full h-full object-cover" />
        </div>
        <div class="text-white">
          <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs md:text-sm mb-4">COACH PROFILE</p>
          <h2 class="text-3xl md:text-4xl font-black font-display mb-2 leading-tight tracking-tight">
            Kota Mizukami
          </h2>
          <p class="text-white/50 text-sm mb-8">Head Coach &amp; Founder, Oshinobi Tennis Academy</p>
          <div class="w-12 h-0.5 bg-accent mb-8"></div>
          <ul class="text-white/70 leading-loose mb-8 space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>Competed in national tournaments since junior years</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>YouTube channel with 7,500+ subscribers</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>Specializes in doubles strategy &amp; tactical coaching</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>Basic English OK &mdash; tennis instructions and simple conversation</span>
            </li>
          </ul>
          <div class="flex flex-wrap gap-4">
            <a href="https://www.youtube.com/channel/UCKtgQuL9B0c8y42hHnx8JQQ" target="_blank" rel="noopener" class="rounded-full border-2 border-accent text-accent hover:bg-accent hover:text-primary-dark font-bold px-8 py-3 transition-all duration-300 text-center tracking-wider text-sm inline-block">
              Watch on YouTube
            </a>
            <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="rounded-full border-2 border-white/60 text-white hover:bg-white hover:text-primary-dark font-bold px-8 py-3 transition-all duration-300 text-center tracking-wider text-sm inline-block">
              Message Coach Kota
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LESSON ===== -->
  <section id="lessons" class="py-24 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16 md:mb-20 relative overflow-hidden">
        <p class="text-[4rem] md:text-[6rem] font-black font-display text-primary/[0.03] leading-none -mb-5 md:-mb-7 select-none">LESSON</p>
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2 relative">LESSON</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight relative">International Lesson</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
      </div>

      <div class="max-w-lg mx-auto">
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl transition-all duration-300 border-2 border-accent relative">
          <div class="text-4xl mb-4">&#127758;</div>
          <p class="text-text-light text-sm leading-relaxed mb-4">
            Designed for visitors and international residents in Sapporo. Lessons are conducted in basic English &mdash; tennis instructions, drills, and simple conversation are no problem. Perfect for tourists who want a unique sports experience in Japan.
          </p>
          <ul class="text-sm text-text-light space-y-2 mb-6">
            <li class="flex items-start gap-2">
              <span class="text-accent font-bold">&#10003;</span>
              <span>Basic English supported</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent font-bold">&#10003;</span>
              <span>Up to 2 participants at a time</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent font-bold">&#10003;</span>
              <span>All equipment provided free</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent font-bold">&#10003;</span>
              <span>Flexible scheduling</span>
            </li>
          </ul>
          <p class="text-xs text-text-light">Simple, transparent pricing &mdash; <a href="#pricing" class="text-primary font-bold underline">see below</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section id="pricing" class="py-24 md:py-28 bg-bg-dark">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16 md:mb-20 relative overflow-hidden">
        <p class="text-[4rem] md:text-[6rem] font-black font-display text-primary/[0.03] leading-none -mb-5 md:-mb-7 select-none">PRICE</p>
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2 relative">PRICE</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight relative">Pricing</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-10">
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center">
          <p class="text-sm font-semibold font-display tracking-[0.25em] text-text-light mb-2">60 MIN</p>
          <p class="text-4xl font-black font-display text-primary mb-4">&yen;10,000</p>
          <p class="text-text-light text-sm leading-relaxed">A quick session &mdash; perfect for a first try or a busy travel day.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center border-2 border-accent relative">
          <p class="absolute -top-3 left-1/2 -translate-x-1/2 bg-accent text-primary-dark text-xs font-bold font-display px-4 py-1 rounded-full whitespace-nowrap tracking-wider">MOST POPULAR</p>
          <p class="text-sm font-semibold font-display tracking-[0.25em] text-text-light mb-2">90 MIN</p>
          <p class="text-4xl font-black font-display text-primary mb-4">&yen;13,000</p>
          <p class="text-text-light text-sm leading-relaxed">Enough time for warm-up, drills, and match play. Our recommendation.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center">
          <p class="text-sm font-semibold font-display tracking-[0.25em] text-text-light mb-2">120 MIN</p>
          <p class="text-4xl font-black font-display text-primary mb-4">&yen;16,500</p>
          <p class="text-text-light text-sm leading-relaxed">A full training session for serious improvement.</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm max-w-3xl mx-auto mb-8">
        <ul class="text-sm text-text-light space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-accent font-bold mt-0.5">&#10003;</span>
            <span><strong class="text-text">Price is per lesson, not per person</strong> &mdash; up to 2 players can join at no extra cost. Bring a friend and split it!</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-accent font-bold mt-0.5">&#10003;</span>
            <span><strong class="text-text">Indoor court rental is separate:</strong> &yen;4,400&ndash;&yen;6,600 per hour depending on season and time. Coach Kota arranges the court booking for you &mdash; no Japanese needed.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-accent font-bold mt-0.5">&#10003;</span>
            <span><strong class="text-text">Rackets, balls &amp; coaching all included.</strong> No hidden fees &mdash; local, personal, and honest.</span>
          </li>
        </ul>
      </div>

      <div class="bg-gradient-to-br from-navy-950 to-primary-dark rounded-2xl p-8 max-w-3xl mx-auto mb-12 text-center shadow-lg shadow-primary/10">
        <h3 class="text-white font-bold text-lg mb-3">Cancellation Policy</h3>
        <p class="text-white/70 text-sm leading-relaxed">
          Free cancellation up to <strong class="text-white">7 days</strong> before your lesson.
          Within 7 days, just message us &mdash; we'll do our best to reschedule.<br />
          The court is fully indoors: <strong class="text-white">no weather cancellations, ever.</strong>
        </p>
      </div>

      <div class="text-center">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#booking" class="inline-block rounded-full bg-primary text-white hover:bg-primary-light shadow-lg shadow-primary/20 hover:-translate-y-0.5 font-bold px-12 py-5 transition-all duration-300 tracking-wider text-lg">
            Check Availability
          </a>
          <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="inline-block rounded-full border-2 border-primary text-primary hover:bg-primary hover:text-white font-bold px-12 py-5 transition-all duration-300 tracking-wider text-lg">
            Ask on LINE
          </a>
        </div>
        <p class="text-sm text-text-light mt-6">
          No prepayment required &mdash; we'll confirm payment details along with your reservation.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== WHAT'S INCLUDED ===== -->
  <section class="py-24 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16 md:mb-20 relative overflow-hidden">
        <p class="text-[4rem] md:text-[6rem] font-black font-display text-primary/[0.03] leading-none -mb-5 md:-mb-7 select-none">FEATURES</p>
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2 relative">FEATURES</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight relative">What's Included</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center">
          <div class="text-4xl mb-4">&#127934;</div>
          <h3 class="font-bold mb-3">Personalized Coaching</h3>
          <p class="text-text-light text-sm leading-relaxed">Tailored lessons for all levels, from complete beginners to advanced competitive players.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center">
          <div class="text-4xl mb-4">&#127969;</div>
          <h3 class="font-bold mb-3">Indoor Court</h3>
          <p class="text-text-light text-sm leading-relaxed">Play rain or shine, even in Hokkaido's snowy winter! DecoTurf surface, year-round availability.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center">
          <div class="text-4xl mb-4">&#127873;</div>
          <h3 class="font-bold mb-3">Free Equipment</h3>
          <p class="text-text-light text-sm leading-relaxed">Rackets and balls provided for free. Just bring sportswear and indoor shoes (shoe rental available).</p>
        </div>
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center">
          <div class="text-4xl mb-4">&#128172;</div>
          <h3 class="font-bold mb-3">Basic English OK</h3>
          <p class="text-text-light text-sm leading-relaxed">Coach Kota speaks basic conversational English &mdash; enough for tennis lessons and LINE bookings. He is not a fluent speaker, but tennis instructions and simple conversation are no problem.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HOW TO BOOK ===== -->
  <section id="booking" class="py-24 md:py-28 bg-bg-dark">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16 md:mb-20 relative overflow-hidden">
        <p class="text-[4rem] md:text-[6rem] font-black font-display text-primary/[0.03] leading-none -mb-5 md:-mb-7 select-none">BOOK</p>
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2 relative">BOOK</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight relative">How to Book</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
        <p class="text-text-light mt-4">Via LINE in 3 easy steps &mdash; or use the booking form below (no LINE needed)</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-black font-display mx-auto mb-6 shadow-lg shadow-primary/20">1</div>
          <h3 class="font-bold mb-3">Add us on LINE</h3>
          <p class="text-text-light text-sm leading-relaxed">
            Tap the "Book via LINE" button below. LINE is Japan's most popular messaging app (free to download).
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-black font-display mx-auto mb-6 shadow-lg shadow-primary/20">2</div>
          <h3 class="font-bold mb-3">Send a Message</h3>
          <p class="text-text-light text-sm leading-relaxed">
            Tell us your preferred date, time, lesson duration, and number of participants. We reply in simple English!
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-black font-display mx-auto mb-6 shadow-lg shadow-primary/20">3</div>
          <h3 class="font-bold mb-3">Show Up &amp; Play</h3>
          <p class="text-text-light text-sm leading-relaxed">
            Come to the venue, grab the free equipment, and enjoy your personalized tennis lesson!
          </p>
        </div>
      </div>

      <div class="text-center mb-16">
        <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="inline-block rounded-full bg-accent text-primary-dark hover:bg-accent-light font-bold px-12 py-5 transition-all duration-300 tracking-wider text-lg shadow-lg shadow-accent/20 hover:-translate-y-0.5">
          Book via LINE
        </a>
        <p class="text-sm text-text-light mt-4">LINE is the fastest way to book. We usually reply within a few hours.</p>
      </div>

      <!-- Booking Form for non-LINE users -->
      <div class="max-w-2xl mx-auto bg-white rounded-2xl p-8 md:p-12 ring-1 ring-line shadow-sm">
        <h3 class="text-xl font-bold text-center mb-2">Don't have LINE? No problem.</h3>
