---
import LayoutEN from '../../layouts/LayoutEN.astro';
const base = import.meta.env.BASE_URL;
---

<LayoutEN title="Tennis Lessons in Sapporo, Japan | Oshinobi Tennis Academy" description="Private tennis lessons in Sapporo with an English-speaking coach. International lesson available. Indoor court, all equipment included. Book via LINE.">

  <Fragment slot="head">
    <!-- Open Graph -->
    <meta property="og:title" content="Tennis Lessons in Sapporo, Japan | Oshinobi Tennis Academy" />
    <meta property="og:description" content="Private tennis lessons in Sapporo with an English-speaking coach. Indoor court, all equipment included. Beginners welcome. Book via LINE." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://oshinobitennis.com/en" />
    <meta property="og:site_name" content="Oshinobi Tennis Academy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://oshinobitennis.com/images/hero/court.jpg" />

    <!-- 構造化データ: SportsActivityLocation + Service + FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsActivityLocation",
      "name": "Oshinobi Tennis Academy",
      "description": "Private tennis lessons in Sapporo, Japan. English-speaking coach. Personalized coaching for all levels from beginners to advanced players.",
      "url": "https://oshinobitennis.com/en",
      "sport": "Tennis",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1-2-12-1 Yonesato, Shiroishi-ku",
        "addressLocality": "Sapporo",
        "addressRegion": "Hokkaido",
        "postalCode": "003-0871",
        "addressCountry": "JP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.0536,
        "longitude": 141.4078
      },
      "telephone": "+81-11-827-7171",
      "employee": {
        "@type": "Person",
        "name": "Kota Mizukami",
        "jobTitle": "Head Tennis Coach",
        "description": "English-speaking tennis coach in Sapporo. YouTube channel with 7,000+ subscribers. Nihon University Tennis Team graduate, specializes in doubles strategy.",
        "sameAs": "https://www.youtube.com/channel/UCKtgQuL9B0c8y42hHnx8JQQ"
      },
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "Indoor Court", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Free Equipment Rental", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Free Parking", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "English-Speaking Coach", "value": true }
      ],
      "potentialAction": {
        "@type": "ReserveAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://lin.ee/2CKErIS",
          "actionPlatform": "http://schema.org/DesktopWebPlatform"
        },
        "description": "Contact us via LINE for pricing and availability"
      }
    })} />

    <!-- FAQ 構造化データ -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does the coach speak English?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Coach Kota speaks English and can conduct the entire lesson in English. Communication via LINE is also available in English."
          }
        },
        {
          "@type": "Question",
          "name": "Is the tennis lesson suitable for beginners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. All skill levels are welcome, from complete beginners to advanced players. Lessons are fully personalized to your level and goals."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to bring my own tennis equipment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, rackets and balls are provided for free. Just bring sportswear and indoor court shoes (clean soles). Shoes can also be rented at the venue."
          }
        },
        {
          "@type": "Question",
          "name": "Where are the tennis lessons held in Sapporo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lessons are held at PLACE OF SPORTS NEO, an indoor sports facility in Shiroishi-ku, Sapporo. The court is available year-round regardless of weather."
          }
        },
        {
          "@type": "Question",
          "name": "How do I book a tennis lesson in Sapporo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simply send a message via LINE (Japan's most popular messaging app). We'll reply in English to confirm your preferred date, time, and lesson duration."
          }
        }
      ]
    })} />
  </Fragment>

  <!-- ===== HERO ===== -->
  <section class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img src={`${base}images/hero/court.jpg`} alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-primary-dark/80 via-primary-dark/60 to-primary-dark/90"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 py-32 w-full">
      <div class="max-w-3xl">
        <p class="text-accent font-bold tracking-[0.3em] text-sm mb-6">TENNIS COACHING IN SAPPORO</p>
        <h1 class="text-4xl md:text-7xl font-black text-white mb-8 leading-[1.1] tracking-tight">
          Tennis Lessons<br />in Sapporo
        </h1>
        <div class="w-16 h-0.5 bg-accent mb-8"></div>
        <p class="text-lg md:text-xl text-white/80 leading-relaxed mb-4 max-w-lg">
          Private tennis coaching with an<br />
          English-speaking Japanese coach
        </p>
        <p class="text-base text-white/60 leading-relaxed mb-12 max-w-lg">
          All levels welcome &mdash; beginners to advanced<br />
          Indoor court &bull; Free equipment &bull; Year-round
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="border border-accent text-accent hover:bg-accent hover:text-primary-dark font-bold px-10 py-4 transition text-center tracking-wider">
            Book a Lesson
          </a>
          <a href="#pricing" class="border border-white/40 text-white hover:bg-white/10 font-bold px-10 py-4 transition text-center tracking-wider">
            Pricing & Contact
          </a>
        </div>
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50">
      <span class="text-xs tracking-[0.2em]">SCROLL</span>
      <div class="w-px h-10 bg-white/30 animate-pulse"></div>
    </div>
  </section>

  <!-- ===== ABOUT COACH ===== -->
  <section id="coach" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-dark to-primary"></div>
    <p class="absolute top-8 left-4 md:left-12 text-[5rem] md:text-[10rem] font-black text-white/[0.03] leading-none tracking-tight">COACH</p>
    <div class="relative max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="aspect-[4/3] overflow-hidden">
          <img src={`${base}images/en/coach_kota.jpg`} alt="Coach Kota Mizukami on court" class="w-full h-full object-cover" />
        </div>
        <div class="text-white">
          <p class="text-accent font-bold tracking-[0.2em] text-sm mb-4">COACH PROFILE</p>
          <h2 class="text-3xl md:text-4xl font-black mb-2 leading-tight">
            Kota Mizukami
          </h2>
          <p class="text-white/50 text-sm mb-8">Head Coach &amp; Founder, Oshinobi Tennis Academy</p>
          <div class="w-12 h-0.5 bg-accent mb-8"></div>
          <ul class="text-white/70 leading-loose mb-8 space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>Competed in national tournaments since junior years</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>Nihon University Tennis Team graduate</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>YouTube channel with 7,200+ subscribers</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>Specializes in doubles strategy &amp; tactical coaching</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&#9670;</span>
              <span>English-speaking &mdash; lessons conducted entirely in English</span>
            </li>
          </ul>
          <div class="flex flex-wrap gap-4">
            <a href="https://www.youtube.com/channel/UCKtgQuL9B0c8y42hHnx8JQQ" target="_blank" rel="noopener" class="border border-accent text-accent hover:bg-accent hover:text-primary-dark font-bold px-8 py-3 transition text-center tracking-wider text-sm inline-block">
              Watch on YouTube
            </a>
            <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="border border-white/40 text-white hover:bg-white/10 font-bold px-8 py-3 transition text-center tracking-wider text-sm inline-block">
              Message Coach Kota
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LESSON ===== -->
  <section id="lessons" class="py-32 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-20">
        <p class="text-[5rem] md:text-[7rem] font-black text-primary/5 leading-none -mb-6 md:-mb-8">LESSON</p>
        <h2 class="text-3xl font-bold relative">International Lesson</h2>
      </div>

      <div class="max-w-lg mx-auto">
        <div class="bg-bg rounded-2xl p-8 shadow-sm border-2 border-accent relative">
          <div class="text-4xl mb-4">&#127758;</div>
          <p class="text-text-light text-sm leading-relaxed mb-4">
            Designed for visitors and international residents in Sapporo. The entire lesson is conducted in English. Perfect for tourists who want a unique sports experience in Japan.
          </p>
          <ul class="text-sm text-text-light space-y-2 mb-6">
            <li class="flex items-start gap-2">
              <span class="text-accent font-bold">&#10003;</span>
              <span>Fully in English</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent font-bold">&#10003;</span>
              <span>Up to 2 participants at a time</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent font-bold">&#10003;</span>
              <span>All equipment provided free</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent font-bold">&#10003;</span>
              <span>Flexible scheduling</span>
            </li>
          </ul>
          <p class="text-xs text-text-light">Contact us via LINE for pricing</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section id="pricing" class="py-32 bg-bg-dark">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-20">
        <p class="text-[5rem] md:text-[7rem] font-black text-primary/5 leading-none -mb-6 md:-mb-8">PRICE</p>
        <h2 class="text-3xl font-bold relative">Pricing</h2>
      </div>

      <div class="bg-white rounded-2xl p-12 shadow-sm text-center max-w-2xl mx-auto">
        <div class="text-5xl mb-6">&#128172;</div>
        <h3 class="text-2xl font-bold mb-4">Contact Us for Detailed Pricing</h3>
        <p class="text-text-light leading-relaxed mb-10">
          We offer flexible pricing depending on duration and number of participants.<br />
          Send us a message on LINE and we'll provide a personalized quote in English.
        </p>
        <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="inline-block border-2 border-primary text-primary hover:bg-primary hover:text-white font-bold px-12 py-5 transition tracking-wider text-lg">
          Contact Us via LINE
        </a>
        <p class="text-sm text-text-light mt-6">
          * Court rental fee applies separately. Rackets &amp; balls provided free.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== WHAT'S INCLUDED ===== -->
  <section class="py-32 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-20">
        <p class="text-[5rem] md:text-[7rem] font-black text-primary/5 leading-none -mb-6 md:-mb-8">FEATURES</p>
        <h2 class="text-3xl font-bold relative">What's Included</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-bg rounded-2xl p-8 shadow-sm text-center">
          <div class="text-4xl mb-4">&#127934;</div>
          <h3 class="font-bold mb-3">Personalized Coaching</h3>
          <p class="text-text-light text-sm leading-relaxed">Tailored lessons for all levels, from complete beginners to advanced competitive players.</p>
        </div>
        <div class="bg-bg rounded-2xl p-8 shadow-sm text-center">
          <div class="text-4xl mb-4">&#127969;</div>
          <h3 class="font-bold mb-3">Indoor Court</h3>
          <p class="text-text-light text-sm leading-relaxed">Play rain or shine, even in Hokkaido's snowy winter! DecoTurf surface, year-round availability.</p>
        </div>
        <div class="bg-bg rounded-2xl p-8 shadow-sm text-center">
          <div class="text-4xl mb-4">&#127873;</div>
          <h3 class="font-bold mb-3">Free Equipment</h3>
          <p class="text-text-light text-sm leading-relaxed">Rackets and balls provided for free. Just bring sportswear and indoor shoes (shoe rental available).</p>
        </div>
        <div class="bg-bg rounded-2xl p-8 shadow-sm text-center">
          <div class="text-4xl mb-4">&#128172;</div>
          <h3 class="font-bold mb-3">English OK</h3>
          <p class="text-text-light text-sm leading-relaxed">Coach Kota speaks English fluently. The entire lesson and booking process is available in English.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HOW TO BOOK ===== -->
  <section id="booking" class="py-32 bg-bg-dark">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-20">
        <p class="text-[5rem] md:text-[7rem] font-black text-primary/5 leading-none -mb-6 md:-mb-8">BOOK</p>
        <h2 class="text-3xl font-bold relative">How to Book</h2>
        <p class="text-text-light mt-4">Book your lesson in 3 easy steps via LINE</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-black mx-auto mb-6">1</div>
          <h3 class="font-bold mb-3">Add us on LINE</h3>
          <p class="text-text-light text-sm leading-relaxed">
            Tap the "Book via LINE" button below. LINE is Japan's most popular messaging app (free to download).
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-black mx-auto mb-6">2</div>
          <h3 class="font-bold mb-3">Send a Message</h3>
          <p class="text-text-light text-sm leading-relaxed">
            Tell us your preferred date, time, lesson duration, and number of participants. We reply in English!
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-black mx-auto mb-6">3</div>
          <h3 class="font-bold mb-3">Show Up &amp; Play</h3>
          <p class="text-text-light text-sm leading-relaxed">
            Come to the venue, grab the free equipment, and enjoy your personalized tennis lesson!
          </p>
        </div>
      </div>

      <div class="text-center mb-16">
        <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="inline-block border border-primary text-primary hover:bg-primary hover:text-white font-bold px-12 py-5 transition tracking-wider text-lg">
          Book via LINE
        </a>
        <p class="text-sm text-text-light mt-4">LINE is the fastest way to book. We usually reply within a few hours.</p>
      </div>

      <!-- Booking Form for non-LINE users -->
      <div class="max-w-2xl mx-auto bg-white rounded-2xl p-8 md:p-12 shadow-sm">
        <h3 class="text-xl font-bold text-center mb-2">Don't have LINE? No problem.</h3>
        <p class="text-text-light text-center text-sm mb-8">Fill out this form and we'll get back to you by email within 24 hours.</p>

        <form id="booking-form" action="https://formsubmit.co/info@oshinobi-co.com" method="POST" class="space-y-6">
          <input type="hidden" name="_subject" value="New Booking Request from English Page">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_template" value="table">
          <input type="text" name="_honey" style="display:none">
          <input type="hidden" name="_next" value="https://oshinobitennis.com/en#booking-thanks">

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-bold mb-2">Your Name <span class="text-red-500">*</span></label>
              <input type="text" id="name" name="name" required placeholder="John Smith" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
            </div>
            <div>
              <label for="email" class="block text-sm font-bold mb-2">Email <span class="text-red-500">*</span></label>
              <input type="email" id="email" name="email" required placeholder="you@example.com" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="date" class="block text-sm font-bold mb-2">Preferred Date <span class="text-red-500">*</span></label>
              <input type="date" id="date" name="preferred_date" required class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
            </div>
            <div>
              <label for="time" class="block text-sm font-bold mb-2">Preferred Time</label>
              <select id="time" name="preferred_time" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white">
                <option value="">Select a time</option>
                <option value="Morning (9:00-12:00)">Morning (9:00-12:00)</option>
                <option value="Afternoon (12:00-17:00)">Afternoon (12:00-17:00)</option>
                <option value="Evening (17:00-21:00)">Evening (17:00-21:00)</option>
                <option value="Flexible">Flexible</option>
              </select>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="duration" class="block text-sm font-bold mb-2">Lesson Duration</label>
              <select id="duration" name="lesson_duration" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white">
                <option value="60min">60 min</option>
                <option value="90min" selected>90 min (recommended)</option>
                <option value="120min">120 min</option>
                <option value="150min">150 min (2.5h)</option>
                <option value="180min">180 min (3h)</option>
              </select>
            </div>
            <div>
              <label for="players" class="block text-sm font-bold mb-2">Number of Players</label>
              <select id="players" name="number_of_players" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-white">
                <option value="1">1 player</option>
                <option value="2">2 players</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-bold mb-2">Message (optional)</label>
            <textarea id="message" name="message" rows="3" placeholder="Any questions, skill level, special requests..." class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary resize-none"></textarea>
          </div>

          <button type="submit" class="w-full bg-primary text-white font-bold py-4 rounded-lg hover:bg-primary/90 transition tracking-wider text-lg">
            Send Booking Request
          </button>
          <p class="text-xs text-text-light text-center">We'll confirm availability and pricing by email. No payment required at this stage.</p>
        </form>

        <div id="booking-thanks" class="hidden text-center py-8">
          <div class="text-4xl mb-4">&#10003;</div>
          <h3 class="text-xl font-bold mb-2">Thank you!</h3>
          <p class="text-text-light">We've received your booking request and will reply within 24 hours.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LOCATION & ACCESS ===== -->
  <section id="access" class="py-32 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-20">
        <p class="text-[5rem] md:text-[7rem] font-black text-primary/5 leading-none -mb-6 md:-mb-8">ACCESS</p>
        <h2 class="text-3xl font-bold relative">Location &amp; Access</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <div>
          <h3 class="text-xl font-bold mb-6">PLACE OF SPORTS NEO</h3>
          <p class="text-text-light leading-loose mb-6">
            1-2-12-1 Yonesato, Shiroishi-ku, Sapporo, Hokkaido<br />
            〒003-0871, Japan
          </p>
          <div class="space-y-4 text-text-light mb-8">
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span><strong class="text-text">By subway + bus:</strong> Take the Tozai Line to "Bus Center Mae" station, then JR Hokkaido Bus (approx. 25 min total from central Sapporo)</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span><strong class="text-text">By taxi:</strong> Approx. 20&ndash;25 min from Sapporo Station</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span><strong class="text-text">By car:</strong> 3 min from Ganrai IC / Kitago IC. Free parking (30+ spaces)</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span>TEL: 011-827-7171 (venue front desk)</span>
            </div>
          </div>
          <div>
            <a href="https://neo-spo.com/" target="_blank" rel="noopener" class="text-primary font-bold border-b border-primary pb-1 hover:opacity-70 transition inline-flex items-center gap-2">
              Visit venue website <span class="text-lg">&rarr;</span>
            </a>
          </div>
        </div>
        <div>
          <div class="aspect-[4/3] overflow-hidden mb-6">
            <img src={`${base}images/en/neo_building.jpg`} alt="PLACE OF SPORTS NEO building exterior" class="w-full h-full object-cover rounded-lg" />
          </div>
          <!-- Google Maps Embed -->
          <div class="aspect-[4/3] overflow-hidden rounded-lg">
            <iframe
