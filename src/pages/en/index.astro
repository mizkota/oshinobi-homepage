---
import LayoutEN from '../../layouts/LayoutEN.astro';
import Reviews from '../../components/Reviews.astro';
import { getReviews } from '../../data/reviews';
import TennisIcon from '../../components/TennisIcon.astro';
import '../../styles/editorial.css';
import '../../styles/services-editorial.css';
const base = import.meta.env.BASE_URL;

const enReviews = getReviews('international', 'en');
const avgRating =
  enReviews.length > 0
    ? enReviews.reduce((sum, r) => sum + r.rating, 0) / enReviews.length
    : 0;
---

<LayoutEN showFooterCta={false} title="Tennis Lessons in Sapporo, Hokkaido | Oshinobi Tennis Academy" description="Private tennis lessons in Sapporo, Hokkaido with an English-friendly Japanese coach. From ¥10,000 (60 min), indoor court open year-round, all equipment free. Beginners welcome.">

  <Fragment slot="head">
    <!-- Open Graph -->
    <meta property="og:title" content="Tennis Lessons in Sapporo, Hokkaido | Oshinobi Tennis Academy" />
    <meta property="og:description" content="Private tennis lessons in Sapporo, Hokkaido with an English-friendly Japanese coach. From ¥10,000 (60 min), indoor court open year-round, all equipment free. Beginners welcome." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://oshinobitennis.com/en/" />
    <meta property="og:site_name" content="Oshinobi Tennis Academy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://oshinobitennis.com/images/hero/coach-kota-20260907.png" />

    <!-- 構造化データ: SportsActivityLocation + Service + FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsActivityLocation",
      "name": "Oshinobi Tennis Academy",
      "description": "Private tennis lessons in Sapporo, Japan. Basic English supported — Japanese coach with conversational English. Personalized coaching for all levels from beginners to advanced players.",
      "url": "https://oshinobitennis.com/en/",
      "image": "https://oshinobitennis.com/images/hero/coach-kota-20260907.png",
      "priceRange": "¥10,000 - ¥18,000 per lesson (court rental separate)",
      "sport": "Tennis",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1-2-12-1 Yonesato, Shiroishi-ku",
        "addressLocality": "Sapporo",
        "addressRegion": "Hokkaido",
        "postalCode": "003-0871",
        "addressCountry": "JP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.0536,
        "longitude": 141.4078
      },
      "telephone": "+81-11-827-7171",
      "employee": {
        "@type": "Person",
        "name": "Kota Mizukami",
        "jobTitle": "Head Tennis Coach",
        "description": "Tennis coach in Sapporo with basic conversational English. Competed in national tournaments since junior years, specializes in doubles strategy.",
        "sameAs": "https://www.youtube.com/channel/UCKtgQuL9B0c8y42hHnx8JQQ"
      },
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "Indoor Court", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Free Equipment Rental", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Free Parking", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Basic English Supported", "value": true }
      ],
      ...(enReviews.length > 0 && {
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": avgRating.toFixed(1),
          "reviewCount": String(enReviews.length),
          "bestRating": "5",
          "worstRating": "1"
        },
        "review": enReviews.map(r => ({
          "@type": "Review",
          "author": { "@type": "Person", "name": r.author },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": String(r.rating),
            "bestRating": "5",
            "worstRating": "1"
          },
          // 原文が英語以外の声は、英語ページの構造化データには英訳を出す
          "reviewBody": r.translation ?? r.body
        }))
      }),
      "potentialAction": {
        "@type": "ReserveAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://line.me/R/ti/p/@853empvr",
          "actionPlatform": "http://schema.org/DesktopWebPlatform"
        },
        "description": "Contact us via LINE or WeChat (ID: Oshinobi_Tennis) for pricing and availability"
      }
    })} />

    <!-- FAQ 構造化データ -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does the coach speak English?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Coach Kota speaks basic conversational English — enough to run a tennis lesson. He is not a fluent speaker, but tennis instructions, drills, and simple conversation are no problem. LINE and WeChat replies are also in basic English."
          }
        },
        {
          "@type": "Question",
          "name": "Is the tennis lesson suitable for beginners?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. All skill levels are welcome, from complete beginners to advanced players. Lessons are fully personalized to your level and goals."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to bring my own tennis equipment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Rackets, balls and indoor court shoes are all free to rent — just bring sportswear and come as you are. You are welcome to bring your own gear if you prefer."
          }
        },
        {
          "@type": "Question",
          "name": "Where are the tennis lessons held in Sapporo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lessons are held at PLACE OF SPORTS NEO, an indoor sports facility at 1-2-12-1 Yonesato, Shiroishi-ku, Sapporo. It is about 15-25 minutes by taxi from Sapporo Station, or 10-15 minutes from JR Shiroishi Station. By bus, get off at Yonesato 1-jo 2-chome, a 3-minute walk. The court is available year-round regardless of weather."
          }
        },
        {
          "@type": "Question",
          "name": "How do I book a tennis lesson in Sapporo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Send us a message on LINE (Japan's most popular messaging app) or on WeChat (WeChat ID: Oshinobi_Tennis). We'll reply in simple English to confirm your preferred date, time, and lesson duration."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a private tennis lesson in Sapporo cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "¥10,000 for 60 minutes, ¥14,000 for 90 minutes, or ¥18,000 for 120 minutes (+¥4,000 per additional 30 minutes) — per lesson, not per person (up to 2 players). Indoor court rental (¥4,400–¥6,600 per hour depending on season and time) is added; the coach arranges the court booking for you."
          }
        },
        {
          "@type": "Question",
          "name": "What is the cancellation policy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Free cancellation up to 7 days before your lesson. Within 7 days, message us and we'll do our best to reschedule. The court is fully indoors, so lessons are never cancelled due to weather."
          }
        }
      ]
    })} />
  </Fragment>

<div class="editorial-home service-page service-en">
  <section class="opening"><div class="opening-inner"><div class="opening-copy" data-reveal>
    <p class="kicker"><span class="live-dot"></span> PRIVATE LESSONS / SAPPORO, JAPAN</p>
    <h1 class="english-title">Play tennis<br />in Sapporo.</h1>
    <p class="opening-description">A local coach. A session shaped around you.<br />For visitors and residents, from your first rally onwards.</p>
    <a href="#booking" class="action action-lime">Check availability <TennisIcon name="arrow" /></a><a href="#pricing" class="quiet-link">Explore lesson pricing <span aria-hidden="true">↓</span></a>
  </div><figure class="opening-portrait"><div class="portrait-window"><img src={`${base}images/hero/coach-kota-20260907.png`} alt="Your coach, Kota Mizukami, on court" width="1086" height="1448" fetchpriority="high" /></div><figcaption><span>YOUR COACH</span><strong>Kota Mizukami</strong><span>SAPPORO</span></figcaption></figure></div><div class="opening-bottom"><span>OSHINOBI TENNIS</span><span>BASIC ENGLISH WELCOME</span></div></section>
  <nav class="service-jump wrap" aria-label="Explore this page"><a href="#lessons">The lesson</a><a href="#pricing">Pricing</a><a href="#booking">Booking</a><a href="#access">Getting here</a><a href="#faq">FAQ</a></nav>

  <section id="lessons" class="service-intro wrap section-space"><div><p class="section-label">01 / YOUR TIME ON COURT</p><h2>Bring your curiosity.<br />We’ll bring the rackets.</h2></div><div><p class="service-lead">Come on your own, or bring a friend.</p><p>Private coaching for up to two players, with drills and practice matched to your level. Rackets, balls and indoor shoes are available to borrow free of charge. Just bring sportswear.</p><p>Lessons take place on a rented indoor court at PLACE OF SPORTS NEO. Kota arranges the court booking for you.</p></div><div class="service-mini"><div><TennisIcon name="people" /><strong>1–2 players</strong><span>Per private lesson</span></div><div><TennisIcon name="racket" /><strong>Equipment included</strong><span>Rackets, balls &amp; shoes</span></div><div><TennisIcon name="chat" /><strong>Basic English</strong><span>Simple instructions &amp; conversation</span></div></div></section>

  <section id="coach" class="service-coach wrap"><figure data-reveal><img src={`${base}images/en/coach_kota.jpg`} alt="Kota Mizukami playing tennis" loading="lazy" /><figcaption>ON COURT / KOTA MIZUKAMI</figcaption></figure><div><p class="section-label">MEET YOUR COACH</p><h2>Kota Mizukami</h2><p class="service-lead">Local knowledge.<br />Personal attention.</p><p>Founder of Oshinobi Tennis Academy, with national tournament experience since his junior years. Kota focuses on doubles strategy and practical advice you can try straight away.</p><p>He speaks basic conversational English, rather than fluent English. Tennis instructions and simple conversation are welcome.</p><a class="line-link" href="https://www.youtube.com/channel/UCKtgQuL9B0c8y42hHnx8JQQ" target="_blank" rel="noopener">Meet Kota on YouTube <TennisIcon name="arrow" /></a></div></section>

  <section id="pricing" class="service-wash section-space"><div class="wrap"><div class="section-top"><div><p class="section-label">02 / LESSON PRICING</p><h2>Your time. Your pace.</h2></div><p>Price per lesson, for up to two players.<br /><strong>Court rental is charged separately.</strong></p></div><div class="price-rail">{[{min:60,price:10000,desc:'A first try or a focused practice session.'},{min:90,price:14000,desc:'Time for warm-up, drills and match play.'},{min:120,price:18000,desc:'More room to work on your game.'}].map(p=><div><p class="price-duration">{p.min}<span> MINUTES</span></p><strong class="price-value">¥{p.price.toLocaleString()}</strong><p>{p.desc}</p></div>)}</div><div class="price-notes"><p><strong>Indoor court:</strong> ¥4,400–¥6,600 per hour, depending on season and time. We confirm the total when arranging your booking.</p><p><strong>Longer sessions:</strong> +¥4,000 for each extra 30 minutes (150 min ¥22,000 / 180 min ¥26,000).</p><p><strong>Cancellation:</strong> Free up to 7 days before your lesson. Within 7 days, contact us to discuss rescheduling.</p><p>No prepayment required. Payment details are confirmed with your reservation.</p></div></div></section>

  <section id="booking" class="wrap section-space"><div class="section-top"><div><p class="section-label">03 / LET’S MAKE A PLAN</p><h2>A message is all<br />it takes to start.</h2></div><p>Send your preferred date, time, duration<br />and number of players. We reply in simple English.</p></div><ol class="service-steps"><li><span>01</span><h3>Say hello</h3><p>Add Kota on LINE or WeChat and tell us when you’d like to play.</p></li><li><span>02</span><h3>Confirm your session</h3><p>We check the court and confirm the time, total price and meeting details.</p></li><li><span>03</span><h3>See you on court</h3><p>Bring sportswear. Borrow the equipment and enjoy your lesson.</p></li></ol><div class="booking-options"><div><p class="section-label">LINE</p><h3>Message Coach Kota</h3><p>Add us on LINE, then send your preferred date and time.</p><a class="action action-lime" href="https://line.me/R/ti/p/@853empvr" target="_blank" rel="noopener">Open LINE <TennisIcon name="arrow" /></a></div><div class="wechat-option"><div><p class="section-label">WECHAT / 微信</p><h3>Scan &amp; say hello</h3><p>Scan this code, or search for our WeChat ID.</p><code>Oshinobi_Tennis</code></div><img src={`${base}images/contact/wechat-qr.png`} alt="Scan this QR code in WeChat to add Coach Kota" width="640" height="640" loading="lazy" /></div></div></section>

  <section id="access" class="legacy-section access-section py-24 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16 md:mb-20 relative overflow-hidden">
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2 relative">ACCESS</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight relative">Location &amp; Access</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
      </div>
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
        <div>
          <h3 class="text-xl font-bold mb-6">PLACE OF SPORTS NEO</h3><p class="text-text-light mb-6">We rent a court at this independent indoor sports facility for your lesson.</p>
          <p class="text-text-light leading-loose mb-6">
            1-2-12-1 Yonesato, Shiroishi-ku, Sapporo, Hokkaido<br />
            〒003-0871, Japan
          </p>
          <div class="space-y-4 text-text-light mb-8">
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span><strong class="text-text">By subway + bus:</strong> Tozai Line to Kikusui Station, then JR Hokkaido Bus &quot;Kiku 7&quot; bound for Hakuryo Koko-mae from the Kikusui 4-jo 2-chome stop (approx. 14 min). Get off at Yonesato 1-jo 2-chome (米里1条2丁目), 3 min walk</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span><strong class="text-text">By taxi:</strong> Approx. 15&ndash;25 min from Sapporo Station, or 10&ndash;15 min from JR Shiroishi Station (the nearest JR station)</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span><strong class="text-text">Direct bus from Sapporo Station:</strong> JR Hokkaido Bus route 8 bound for Oasa 11-chome (approx. 25 min), get off at Yonesato 1-jo 2-chome (米里1条2丁目)</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span><strong class="text-text">By car:</strong> 3 min from Ganrai IC / Kitago IC. Free parking (30+ spaces)</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-primary font-bold mt-0.5">&#9679;</span>
              <span>TEL: 011-827-7171 (venue front desk)</span>
            </div>
          </div>
          <div>
            <a href="https://neo-spo.com/" target="_blank" rel="noopener" class="text-primary font-bold border-b-2 border-accent pb-1 hover:text-primary-light transition duration-300 inline-flex items-center gap-2">
              Visit venue website <span class="text-lg">&rarr;</span>
            </a>
          </div>
        </div>
        <div>
          <div class="aspect-[4/3] overflow-hidden mb-6 rounded-2xl ring-1 ring-line shadow-sm">
            <img src={`${base}images/en/neo_building.jpg`} alt="PLACE OF SPORTS NEO building exterior" class="w-full h-full object-cover" />
          </div>
          <!-- Google Maps Embed -->
          <div class="aspect-[4/3] overflow-hidden rounded-2xl ring-1 ring-line shadow-sm">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2915.5!2d141.4078!3d43.0536!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f0b29f4c2e1b0f1%3A0x4c3b2a1d5e6f7890!2sPLACE+OF+SPORTS+NEO!5e0!3m2!1sen!2sjp!4v1"
              class="w-full h-full border-0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="PLACE OF SPORTS NEO - Google Maps"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
  <Reviews category="international" lang="en" bg="bg-white" />
  <section id="faq" class="legacy-section faq-section py-24 md:py-28 bg-bg-dark">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16 md:mb-20 relative overflow-hidden">
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2 relative">FAQ</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight relative">Frequently Asked Questions</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
      </div>

      <div class="space-y-4">
        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
          <summary class="px-6 md:px-8 py-6 cursor-pointer font-bold text-lg flex items-center justify-between gap-4 hover:text-primary transition duration-300">
            Does the coach speak English?
            <span class="text-accent-dark text-2xl shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-6 md:px-8 pb-8 text-text-light leading-relaxed border-t border-line pt-5">
            Yes, Coach Kota speaks basic conversational English &mdash; enough to run a tennis lesson. He is not a fluent speaker, but tennis instructions, drills, and simple conversation are no problem. Messages on LINE and WeChat (booking, questions) are also handled in basic English, so you don't need Japanese to book or take a lesson.
          </div>
        </details>

        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
          <summary class="px-6 md:px-8 py-6 cursor-pointer font-bold text-lg flex items-center justify-between gap-4 hover:text-primary transition duration-300">
            I'm a complete beginner. Is that OK?
            <span class="text-accent-dark text-2xl shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-6 md:px-8 pb-8 text-text-light leading-relaxed border-t border-line pt-5">
            Absolutely! All skill levels are welcome, from people who have never held a racket to advanced competitive players. Lessons are fully personalized to your current level and goals.
          </div>
        </details>

        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
          <summary class="px-6 md:px-8 py-6 cursor-pointer font-bold text-lg flex items-center justify-between gap-4 hover:text-primary transition duration-300">
            Do I need to bring my own racket or equipment?
            <span class="text-accent-dark text-2xl shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-6 md:px-8 pb-8 text-text-light leading-relaxed border-t border-line pt-5">
            No. Rackets, balls and indoor court shoes are all free to rent, so you can turn up empty-handed — just bring sportswear. You are of course welcome to bring your own racket and shoes if you prefer.
          </div>
        </details>

        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
          <summary class="px-6 md:px-8 py-6 cursor-pointer font-bold text-lg flex items-center justify-between gap-4 hover:text-primary transition duration-300">
            Can I play even during winter or rainy days?
            <span class="text-accent-dark text-2xl shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-6 md:px-8 pb-8 text-text-light leading-relaxed border-t border-line pt-5">
            Yes! The court at PLACE OF SPORTS NEO is fully indoors, so lessons are available year-round regardless of weather. Even during Hokkaido's snowy winters, you can enjoy tennis comfortably.
          </div>
        </details>

        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
          <summary class="px-6 md:px-8 py-6 cursor-pointer font-bold text-lg flex items-center justify-between gap-4 hover:text-primary transition duration-300">
            Can I contact you on WeChat? What is LINE?
            <span class="text-accent-dark text-2xl shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-6 md:px-8 pb-8 text-text-light leading-relaxed border-t border-line pt-5">
            Yes &mdash; WeChat works exactly the same as LINE for us. Scan the QR code in the <a href="#booking" class="underline">booking section</a>, or search the WeChat ID <span class="font-bold text-text">Oshinobi_Tennis</span> under &ldquo;Add Contacts&rdquo;.<br /><br />
            LINE is Japan's most popular free messaging app (similar to WhatsApp). Download it from the App Store or Google Play, then tap our "Open LINE" button to add us as a friend. Either way, send us your preferred date and time and we'll reply in simple English.
          </div>
        </details>

        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
          <summary class="px-6 md:px-8 py-6 cursor-pointer font-bold text-lg flex items-center justify-between gap-4 hover:text-primary transition duration-300">
            How do I get to the venue from central Sapporo?
            <span class="text-accent-dark text-2xl shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-6 md:px-8 pb-8 text-text-light leading-relaxed border-t border-line pt-5">
            A taxi is easiest: about 15&ndash;25 min from Sapporo Station, or 10&ndash;15 min from JR Shiroishi Station, which is the closest JR station. By public transport, take the Tozai subway line to Kikusui Station and catch the JR Hokkaido Bus &quot;Kiku 7&quot; bound for Hakuryo Koko-mae from the Kikusui 4-jo 2-chome stop — about 14 minutes. There is also a direct JR Hokkaido Bus from Sapporo Station (route 8, bound for Oasa 11-chome, about 25 min). Either bus stops at Yonesato 1-jo 2-chome (米里1条2丁目), a 3-minute walk from the courts. If you drive, there is free parking for 30+ cars on site.
          </div>
        </details>

        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
          <summary class="px-6 md:px-8 py-6 cursor-pointer font-bold text-lg flex items-center justify-between gap-4 hover:text-primary transition duration-300">
            How much does a private tennis lesson in Sapporo cost?
            <span class="text-accent-dark text-2xl shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-6 md:px-8 pb-8 text-text-light leading-relaxed border-t border-line pt-5">
            &yen;10,000 for 60 minutes, &yen;14,000 for 90 minutes, or &yen;18,000 for 120 minutes (+&yen;4,000 per additional 30 minutes) &mdash; per lesson, not per person (up to 2 players). Indoor court rental (&yen;4,400&ndash;&yen;6,600 per hour depending on season and time) is added; Coach Kota arranges the court booking for you.
          </div>
        </details>

        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
          <summary class="px-6 md:px-8 py-6 cursor-pointer font-bold text-lg flex items-center justify-between gap-4 hover:text-primary transition duration-300">
            What does the court rental fee include?
            <span class="text-accent-dark text-2xl shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <div class="px-6 md:px-8 pb-8 text-text-light leading-relaxed border-t border-line pt-5">
            The court rental fee is charged by the venue and covers the use of the indoor court: &yen;4,400&ndash;&yen;6,600 per hour depending on season and time of day. This is separate from the lesson fee. Coach Kota arranges the court booking for you and confirms the exact cost before your lesson.
          </div>
        </details>

        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 group overflow-hidden">
