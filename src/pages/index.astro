---
import Layout from '../layouts/Layout.astro';
import TennisIcon from '../components/TennisIcon.astro';
import '../styles/editorial.css';
import Reviews from '../components/Reviews.astro';
import { posts } from '../data/blog-posts';
const base = import.meta.env.BASE_URL;
---

<Layout title="札幌の少人数テニスレッスン" description="水上皓太が指導する、札幌の御忍庭球塾。レギュラー6名の少人数レッスン。グループレッスンはPLACE OF SPORTS NEOのコートを借りて開催しています。" showFooterCta={false} socialImage="https://oshinobitennis.com/images/hero/coach-kota-20260907.png">

  <Fragment slot="head">
    <!-- 構造化データ: SportsActivityLocation -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsActivityLocation",
      "name": "御忍庭球塾",
      "description": "札幌市白石区のテニススクール。少人数制グループレッスン・プライベートレッスン。",
      "url": "https://oshinobitennis.com",
      "sport": "Tennis",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "白石区米里1条2丁目12-1",
        "addressLocality": "札幌市",
        "addressRegion": "北海道",
        "addressCountry": "JP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.0536,
        "longitude": 141.4078
      },
      "amenityFeature": [
        {
          "@type": "LocationFeatureSpecification",
          "name": "インドアデコターフコート",
          "value": true
        }
      ],
      "offers": [
        {
          "@type": "Offer",
          "name": "グループレッスン月会費",
          "price": "12000",
          "priceCurrency": "JPY",
          "description": "通常期（5月〜10月）月額12,000円、冬期（11月〜4月）月額13,000円"
        },
        {
          "@type": "Offer",
          "name": "体験レッスン",
          "price": "3000",
          "priceCurrency": "JPY",
          "description": "初回体験レッスン"
        }
      ]
    })} />
  </Fragment>

  <div class="editorial-home">
    <section class="opening">
      <div class="opening-inner">
        <div class="opening-copy" data-reveal>
          <p class="kicker"><span class="live-dot"></span> 札幌・白石区の少人数テニスレッスン</p>
          <h1><span>いつもの練習に、</span><br /><span>気づきをひとつ。</span></h1>
          <p class="opening-description">一人ひとりのプレーを見て、<br />その場で伝える少人数レッスン。</p>
          <a href={`${base}courses`} class="action action-lime">コース・料金を見る <TennisIcon name="arrow" /></a>
          <a class="quiet-link" href="https://lin.ee/2CKErIS" target="_blank" rel="noopener">体験について相談する <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="opening-portrait">
          <div class="portrait-window"><img src={`${base}images/hero/coach-kota-20260907.png`} width="1086" height="1448" alt="ラケットを手に笑顔を見せる水上皓太コーチ" fetchpriority="high" /></div>
          <figcaption><span>YOUR COACH</span><strong>水上 皓太</strong><span>KOTA MIZUKAMI</span></figcaption>
        </figure>
      </div>
      <div class="opening-bottom"><span>OSHINOBI TENNIS / SAPPORO</span><a href="#lesson">レッスンについて <span aria-hidden="true">↓</span></a></div>
    </section>

    <div class="lesson-facts wrap">
      <div><TennisIcon name="people" /><p><span>グループレッスン</span><strong>レギュラー <b>6</b> 名</strong><small>振替を含む場合は最大7名</small></p></div>
      <div><TennisIcon name="racket" /><p><span>はじめての方へ</span><strong>初回体験 <b>3,000</b> 円</strong><small>体験日程はLINEでご案内</small></p></div>
      <div><TennisIcon name="pin" /><p><span>グループレッスンの会場</span><strong>札幌市白石区</strong><small>PLACE OF SPORTS NEOのコートを借りて開催</small></p></div>
    </div>

    <section id="lesson" class="lesson-story wrap section-space">
      <div class="section-heading"><p class="section-label">01 / OUR LESSON</p><h2>打って、試して、<br />少しずつ。</h2></div>
      <div class="lesson-body" data-reveal><p class="lead-text">うまく打てた一本も、<br />思うようにいかなかった一本も。</p><p>コーチがプレーを見ながら、その場でアドバイスします。気になることは、コートで聞いてください。少人数で、じっくり打つ時間をつくっています。</p><a class="line-link" href={`${base}private-lesson#coach`}>水上皓太・コーチ紹介 <TennisIcon name="arrow" /></a></div>
      <figure class="lesson-photo" data-reveal><img src={`${base}images/features/snapshot.jpg`} alt="御忍庭球塾の少人数レッスンの様子" width="1200" height="800" loading="lazy" /><figcaption><span>ON THE COURT</span> 御忍庭球塾のレッスン風景</figcaption></figure>
      <aside class="venue-note"><TennisIcon name="pin" /><div><h3>いつものコートで。</h3><p>グループレッスンは、PLACE OF SPORTS NEOのインドアコートを借りて行います。</p><a class="line-link" href="https://neo-spo.com/" target="_blank" rel="noopener">会場の公式サイト <span aria-hidden="true">↗</span></a></div></aside>
    </section>

    <section class="lesson-options section-space">
      <div class="wrap">
        <div class="section-top"><div><p class="section-label">02 / FIND YOUR LESSON</p><h2>あなたに合う、<br class="mobile-break" />レッスンを。</h2></div><p>仲間と打つ時間も、<br />自分の課題に向き合う時間も。</p></div>
        <div class="course-links">
          <a class="course-link" href={`${base}courses`}><span class="course-number">01</span><div><span class="course-en">GROUP LESSON</span><h3>グループレッスン</h3><p>レギュラー6名。仲間と一緒に練習する、<br class="wide-break" />定期的なテニスの時間。</p><span class="course-detail">時間割・月会費・体験料金</span></div><span class="round-arrow"><TennisIcon name="arrow" /></span></a>
          <a class="course-link" href={`${base}private-lesson`}><span class="course-number">02</span><div><span class="course-en">PRIVATE LESSON</span><h3>プライベートレッスン</h3><p>練習したいことに合わせて。<br />一人でも、仲間と一緒でも相談できます。</p><span class="course-detail">レッスン内容・ご相談</span></div><span class="round-arrow"><TennisIcon name="arrow" /></span></a>
        </div>
        <a class="international-link" href={`${base}en`}><span>Visiting Sapporo?</span><span>Tennis lessons in English <span aria-hidden="true">↗</span></span></a>
      </div>
    </section>

    <section class="journal wrap section-space">
      <div class="journal-copy"><p class="section-label">03 / OFF THE COURT</p><h2>コートの外でも、<br />テニスの話を。</h2><p>ダブルスの動きや考え方を、動画で解説。<br />次の練習のヒントにどうぞ。</p><a class="line-link" href="https://www.youtube.com/channel/UCKtgQuL9B0c8y42hHnx8JQQ" target="_blank" rel="noopener"><TennisIcon name="play" /> YouTubeチャンネル <span aria-hidden="true">↗</span></a></div>
      <div class="video-window" data-reveal><iframe src="https://www.youtube.com/embed/bXEScAkbFYI" title="御忍庭球塾のダブルス解説動画" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
    </section>

    <section class="updates wrap">
      <div class="section-top"><div><p class="section-label">INFORMATION</p><h2>塾からのお知らせ</h2></div><a class="line-link" href={`${base}blog`}>一覧へ <TennisIcon name="arrow" /></a></div>
      <div class="update-list">{posts.slice(0,3).map(post => <a href={`${base}blog/${post.slug}/`}><time>{post.date}</time><span class="update-category">{post.category}</span><span class="update-title">{post.title}</span><TennisIcon name="arrow" /></a>)}</div>
      <a class="string-service string-service-photo" href={`${base}gut24`}><img src={`${base}images/gut24/hands.png`} alt="ガット張替の手元" width="1223" height="1286" loading="lazy" /><div><span>RACKET STRINGING</span><h3>ガット張替も、御忍で。</h3><p>OSHINOBI GUT 24 / 24時間受付</p></div><TennisIcon name="arrow" /></a>
    </section>
    <Reviews category="lesson" lang="ja" bg="bg-white" />

    <section class="closing section-space">
      <svg class="court-lines" viewBox="0 0 500 360" fill="none" aria-hidden="true"><path d="M20 20h460v320H20zM70 20v320M430 20v320M20 180h460M70 85h360M70 275h360M250 85v190" /></svg>
      <div class="wrap closing-inner"><div><p class="section-label">SEE YOU ON THE COURT</p><h2>まずは一度、<br />一緒に打ちませんか。</h2></div><div class="closing-action"><p>初回体験 <strong>3,000</strong> 円</p><a class="action action-lime" href="https://lin.ee/2CKErIS" target="_blank" rel="noopener"><TennisIcon name="chat" /> LINEで体験を相談する <TennisIcon name="arrow" /></a><small>ご希望の日程とテニスの経験をお知らせください。<br />空き状況を確認してご案内します。</small></div></div>
    </section>
  </div>
</Layout>
