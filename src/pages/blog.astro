---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/blog-posts';
const base = import.meta.env.BASE_URL;
---

<Layout title="お知らせ・ブログ">
  <section class="relative py-20 md:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-primary-dark to-primary"></div>
    <p class="absolute top-4 left-4 md:left-12 text-[5rem] md:text-[10rem] font-black font-display text-white/[0.03] leading-none select-none">NEWS</p>
    <div class="relative max-w-6xl mx-auto px-4 md:px-6 text-center text-white">
      <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs md:text-sm mb-4">NEWS</p>
      <h1 class="text-[clamp(2rem,5vw,3rem)] font-black tracking-tight mb-4">お知らせ</h1>
      <div class="w-12 h-0.5 bg-accent mx-auto"></div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="space-y-6">
        {posts.map((post) => (
          <a href={`${base}blog/${post.slug}/`} class="group block bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <article class="flex flex-col sm:flex-row">
              {post.image && (
                <div class="sm:w-48 h-40 sm:h-auto bg-bg-dark shrink-0 overflow-hidden">
                  <img src={`${base}images/blog/${post.image}`} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
                </div>
              )}
              <div class="flex-1 p-6 md:p-8">
                <div class="flex items-center gap-3 mb-3">
                  <span class="bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full tracking-wider">
                    {post.category}
                  </span>
                  <time class="text-sm text-text-light font-display">{post.date}</time>
                </div>
                <h2 class="text-lg font-bold mb-2 group-hover:text-primary transition duration-300">{post.title}</h2>
                <p class="text-text-light text-sm leading-relaxed">{post.excerpt}</p>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
