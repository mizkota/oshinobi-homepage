---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/blog-posts';
const base = import.meta.env.BASE_URL;
---

<Layout title="お知らせ・ブログ">
  <section class="relative py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-dark to-primary"></div>
    <div class="relative max-w-6xl mx-auto px-4 text-center text-white">
      <h1 class="text-4xl font-bold mb-4">お知らせ</h1>
    </div>
  </section>

  <section class="py-20 bg-bg">
    <div class="max-w-4xl mx-auto px-4">
      <div class="space-y-6">
        {posts.map((post) => (
          <a href={`${base}blog/${post.slug}/`} class="block bg-white rounded-2xl shadow-sm hover:shadow-lg transition overflow-hidden">
            <article class="flex flex-col sm:flex-row">
              {post.image && (
                <div class="sm:w-48 h-40 sm:h-auto bg-gray-100 shrink-0 overflow-hidden">
                  <img src={`${base}images/blog/${post.image}`} alt={post.title} class="w-full h-full object-cover" />
                </div>
              )}
              <div class="flex-1 p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class="bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full">
                    {post.category}
                  </span>
                  <time class="text-sm text-text-light">{post.date}</time>
                </div>
                <h2 class="text-lg font-bold mb-2 hover:text-primary transition">{post.title}</h2>
                <p class="text-text-light text-sm leading-relaxed">{post.excerpt}</p>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
