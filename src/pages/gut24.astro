---
import Layout from '../layouts/Layout.astro';
import Reviews from '../components/Reviews.astro';
import { getReviews, googleRating } from '../data/reviews';
import TennisIcon from '../components/TennisIcon.astro';
import '../styles/editorial.css';
import '../styles/services-editorial.css';
const base = import.meta.env.BASE_URL;

const gut24Reviews = getReviews('gut24', 'ja');

const strings = [
  {
    name: 'ツイスター',
    brand: 'Signum Pro',
    material: 'ポリ',
    gauge: '1.20mm',
    price: 2800,
    image: 'twister.webp',
    desc: 'スピン性能に優れたコスパ抜群のポリ。回転系プレーヤーに。',
    color: '#FFD700',
  },
  {
    name: 'トルネード',
    brand: 'Signum Pro',
    material: 'ポリ',
    gauge: '1.23mm',
    price: 3000,
    image: 'tornado.webp',
    desc: '螺旋形状でスピンとコントロールを両立。バランス型。',
    color: '#333333',
  },
  {
    name: 'ポリツアープロ',
    brand: 'YONEX',
    material: 'ポリ',
    gauge: '1.25mm',
    price: 3200,
    image: 'polytour-pro.webp',
    desc: 'ソフトな打球感とスピン性能を兼ね備えた万能型。',
    color: '#2C2C2C',
  },
  {
    name: 'HYPER-G',
    brand: 'Solinco',
    material: 'ポリ',
    gauge: '1.25mm',
    price: 3200,
    image: 'hyper-g-clean.png',
    desc: '五角形断面のスピン特化。ヘビースピナーに人気。',
    color: '#7FFF00',
  },
  {
    name: 'RPMブラスト',
    brand: 'Babolat',
    material: 'ポリ',
    gauge: '1.25/1.30mm',
    price: 3200,
    image: 'rpm-blast.webp',
    desc: 'ナダル使用で有名。高いスピン性能とコントロール。',
    color: '#1A1A1A',
  },
  {
    name: 'マッハ-10',
    brand: 'Solinco',
    material: 'ポリ',
    gauge: '1.25mm',
    price: 3200,
    image: 'mach10.jpg',
    desc: 'パワーとスピンの融合。爆発的なボールスピード。',
    color: '#00BFFF',
  },
  {
    name: 'ポリツアーレブ',
    brand: 'YONEX',
    material: 'ポリ',
    gauge: '1.25mm',
    price: 3300,
    image: 'polytour-rev.webp',
    desc: 'ポリツアープロ上位モデル。より高い反発力。',
    color: '#FF6600',
  },
  {
    name: 'アルパワー',
    brand: 'Luxilon',
    material: 'ポリ',
    gauge: '1.25mm',
    price: 3300,
    image: 'alu-power.webp',
    desc: 'フェデラーも使用した名作。全てが高水準。',
    color: '#1A3A6B',
  },
  {
    name: 'X-ONE バイフェイズ',
    brand: 'Tecnifibre',
    material: 'ナイロン',
    gauge: '1.24mm',
    price: 3700,
    image: 'xone-biphase.webp',
    desc: 'ナイロン最高峰。ナチュラルに近い柔らかさ。',
    color: '#E67E22',
  },
];
---

<Layout contactLabel="ガットを相談する" contactUrl="https://lin.ee/yLlhrrT" socialImage="https://oshinobitennis.com/images/logo/gut24-logo.png" showFooterCta={false} title="札幌のガット張替 OSHINOBI GUT 24｜24時間受付・非対面" description="札幌市白石区JR白石駅徒歩2分のガット張替サービス。24時間ポスト受付・非対面で完結。全品工賃込み2,800円〜3,700円。LINE注文で最短2日仕上がり。Google★5.0。">

  <Fragment slot="head">
    <!-- 構造化データ: LocalBusiness + Service -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "OSHINOBI GUT 24",
      "description": "札幌市白石区のガット張替サービス。24時間ポスト受付・非対面で完結。全品工賃込み2,800円〜3,700円。",
      "url": "https://oshinobitennis.com/gut24",
      "telephone": "",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "札幌市",
        "addressRegion": "北海道",
        "addressCountry": "JP",
        "streetAddress": "白石区 JR白石駅北口 徒歩2分"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.0536,
        "longitude": 141.4078
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      },
      "priceRange": "¥2,800〜¥3,700",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": String(googleRating.gut24.ratingValue),
        "reviewCount": String(googleRating.gut24.reviewCount),
        "bestRating": "5",
        "worstRating": "1"
      },
      "review": gut24Reviews.map(r => ({
        "@type": "Review",
        "author": { "@type": "Person", "name": r.author },
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": String(r.rating),
          "bestRating": "5",
          "worstRating": "1"
        },
        "reviewBody": r.body
      })),
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "ガット張替メニュー",
        "itemListElement": strings.map(s => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": `${s.name}（${s.brand}）ガット張替`,
            "description": s.desc
          },
          "price": s.price,
          "priceCurrency": "JPY"
        }))
      }
    })} />
  </Fragment>

<div class="editorial-home service-page service-gut">
  <section class="opening"><div class="opening-inner"><div class="opening-copy" data-reveal><p class="kicker"><span class="live-dot"></span> OSHINOBI GUT 24 / SAPPORO</p><h1>次の一打を、<br />張り替えよう。</h1><p class="opening-description">LINEで注文、ポストで受け渡し。<br />あなたの時間で使える、ガット張替サービス。</p><a href="https://lin.ee/yLlhrrT" class="action action-lime" target="_blank" rel="noopener">LINEで注文・相談 <TennisIcon name="arrow" /></a><a href="#lineup" class="quiet-link">ストリング・料金を見る <span aria-hidden="true">↓</span></a></div><figure class="stringing-portrait" data-reveal><img src={`${base}images/gut24/stringer.png`} alt="ラケットのガットを張る水上皓太" width="1086" height="1448" fetchpriority="high" /><figcaption><span>OSHINOBI GUT 24</span><span>張替作業のひとこま</span></figcaption></figure></div><div class="opening-bottom"><span>RACKET STRINGING / SHIROISHI</span><a href="#how-to">ご利用の流れ <span aria-hidden="true">↓</span></a></div></section>
  <nav class="service-jump wrap" aria-label="ページ内メニュー"><a href="#lineup">商品・料金</a><a href="#how-to">ご利用の流れ</a><a href="#location">ポストの場所</a><a href="#faq">よくある質問</a></nav>
  <section class="gut-facts wrap"><div><span>受付・受け渡し</span><strong>24<small>時間</small></strong><p>非対面のポスト方式</p></div><div><span>全品工賃込み</span><strong>{Math.min(...strings.map(s=>s.price)).toLocaleString()}<small>円〜</small></strong><p>ストリング代＋張替工賃</p></div><div><span>仕上がりの目安</span><strong>約2<small>日</small></strong><p>混雑状況によって前後します</p></div></section>
  <section class="service-intro wrap section-space"><div><p class="section-label">01 / FITS YOUR DAY</p><h2>仕事のあとでも、<br />早朝でも。</h2></div><div><p class="service-lead">お店の営業時間に、<br />予定を合わせなくていい。</p><p>LINEで注文したら、JR白石駅北口から徒歩2分の専用ポストへ。完成のお知らせもLINEに届きます。御忍庭球塾の会員でない方もご利用いただけます。</p><a class="line-link" href="#how-to">注文から受け取りまで <TennisIcon name="arrow" /></a></div></section>

  <section class="workshop-story wrap" aria-labelledby="workshop-title">
    <div class="workshop-heading"><p class="section-label">AT THE STRINGING MACHINE</p><h2 id="workshop-title">張り替える手元まで、<br />見える安心を。</h2><p>お預かりしたラケットと向き合う、張替作業のひとこま。<br />ストリングや張りの強さに迷ったら、LINEでご相談ください。</p></div>
    <figure class="workshop-detail" data-reveal><img src={`${base}images/gut24/hands.png`} alt="ストリングを通す手元とラケットの接写" width="1223" height="1286" loading="lazy" /><figcaption><span>01 / DETAIL</span>ストリングを通す手元</figcaption></figure>
    <figure class="workshop-scene" data-reveal><img src={`${base}images/gut24/workshop.png`} alt="ストリングマシンに向かって張替作業をする様子" width="1086" height="1448" loading="lazy" /><figcaption><span>02 / WORKSHOP</span>張替作業の風景</figcaption></figure>
  </section>
  <section id="lineup" class="service-wash section-space"><div class="wrap"><div class="section-top"><div><p class="section-label">02 / STRING COLLECTION</p><h2>打ち心地から、選ぶ。</h2></div><p>掲載価格はストリング代・工賃込み。<br />最新の在庫・料金はLINEでご確認ください。<br />商品画像は参考です。取扱ゲージは各商品欄をご覧ください。</p></div><div class="product-grid">{strings.map((s,index)=><article class="string-product" data-reveal><div class="product-photo"><span class="product-index">{String(index+1).padStart(2,'0')}</span><img src={`${base}images/strings/${s.image}`} alt={`${s.brand} ${s.name}`} loading="lazy" /></div><div class="product-info"><p class="product-brand">{s.brand}</p><h3>{s.name}</h3><p class="product-spec">{s.material} / {s.gauge}</p><p class="product-desc">{s.desc}</p><div class="product-bottom"><p><strong>{s.price.toLocaleString()}</strong> 円<small>工賃込み</small></p><a href="https://lin.ee/yLlhrrT" target="_blank" rel="noopener" aria-label={`${s.name}についてLINEで相談`}><span>相談する</span><TennisIcon name="arrow" /></a></div></div></article>)}</div><div class="tension-note"><TennisIcon name="racket" /><div><h3>テンションに迷ったら。</h3><p>プレースタイルやラケットに合わせてLINEでご相談ください。1ポンド単位で調整できます。</p></div><a href="https://lin.ee/yLlhrrT" target="_blank" rel="noopener" class="line-link">相談する <TennisIcon name="arrow" /></a></div></div></section>
  <section id="how-to" class="wrap section-space"><div class="section-top"><div><p class="section-label">03 / DROP OFF. PICK UP. PLAY.</p><h2>注文から受け取りまで。</h2></div><p>LINEとポストで完結。<br />お支払いはPayPayまたは現金の事前払い。</p></div><ol class="service-steps"><li><span>01</span><TennisIcon name="chat" /><h3>LINEで注文</h3><p>メニューからストリング・縦テンション・横テンションを選びます。</p></li><li><span>02</span><TennisIcon name="pin" /><h3>ポストに預ける</h3><p>専用ポストにラケットを投函。ラケットを預ける際にお支払いください。</p></li><li><span>03</span><TennisIcon name="racket" /><h3>通知が届いたら、受け取り</h3><p>約2日が目安です。LINEで届くポスト番号と暗証番号で受け取れます。</p></li></ol><div class="guide-videos">{[{id:'uoU5HUspGDQ',title:'ポストへの行き方'},{id:'LM1KFw8jGu8',title:'ラケットの投函方法'},{id:'k02k8nlYVG4',title:'ラケットの受け取り方'}].map(v=><div><p>{v.title}</p><iframe src={`https://www.youtube.com/embed/${v.id}`} title={v.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>)}</div></section>
  <section id="location" class="legacy-section location-section py-24 md:py-28 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2">LOCATION</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight">ポストの場所</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
        <p class="text-text-light text-lg mt-4">札幌市 JR白石駅北口から<strong class="text-text">徒歩2分</strong></p>
      </div>
      <div class="location-visuals">
        <figure class="locker-photo" data-reveal><img src={`${base}images/gut24/locker.png`} alt="ラケットの預け入れと受け取りに使う専用ポスト" width="1086" height="1448" loading="lazy" /><figcaption>預け入れ・受け取り用の専用ポスト</figcaption></figure>
        <div class="location-map"><p class="section-label">DROP OFF / PICK UP</p><h3>このポストが、受け渡し場所です。</h3><p>まずはLINEでご注文ください。<br />預け入れ・受け取りの手順は、上の案内動画でも確認できます。</p>
      <div class="rounded-2xl overflow-hidden ring-1 ring-line shadow-lg">
        <iframe title="OSHINOBI GUT 24のポスト案内地図" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2915.5!2d141.4!3d43.05!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f0b2b0052260585%3A0x99699b9354aef3e!2sOSHINOBI%20GUT%2024!5e0!3m2!1sja!2sjp!4v1" width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
        </div>
      </div>
    </div>
  </section>
  <Reviews category="gut24" lang="ja" note={`Googleマップのクチコミより（★${googleRating.gut24.ratingValue.toFixed(1)} / ${googleRating.gut24.reviewCount}件）`} writeReviewUrl={googleRating.gut24.writeReviewUrl} />
  <section id="faq" class="legacy-section faq-section py-24 md:py-28 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2">FAQ</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight">よくある質問</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
      </div>
      <div class="space-y-4">
        <details class="bg-white rounded-2xl shadow-sm overflow-hidden group" open>
          <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer hover:text-primary transition duration-300 font-bold text-lg">
            持ち込みストリングは使えますか？
            <span class="text-accent-dark text-2xl ml-4 shrink-0 group-open:rotate-45 transition-transform duration-300">+</span>
          </summary>
          <div class="px-6 pb-6 pt-5 text-text-light leading-relaxed border-t border-line">
            申し訳ございませんが、品質管理のため指定ストリングのみの対応となります。上記ラインナップからお選びください。
          </div>
        </details>
        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer hover:text-primary transition duration-300 font-bold text-lg">
            仕上がりまでどのくらいかかりますか？
            <span class="text-accent-dark text-2xl ml-4 shrink-0 group-open:rotate-45 transition-transform duration-300">+</span>
          </summary>
          <div class="px-6 pb-6 pt-5 text-text-light leading-relaxed border-t border-line">
            通常約2日程度でお渡し可能です。混雑状況によって前後する場合がありますが、LINEで随時お知らせします。
          </div>
        </details>
        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer hover:text-primary transition duration-300 font-bold text-lg">
            支払い方法は？
            <span class="text-accent-dark text-2xl ml-4 shrink-0 group-open:rotate-45 transition-transform duration-300">+</span>
          </summary>
          <div class="px-6 pb-6 pt-5 text-text-light leading-relaxed border-t border-line">
            PayPayまたは現金（事前払い）に対応しています。ラケット投函時にお支払いください。
          </div>
        </details>
        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer hover:text-primary transition duration-300 font-bold text-lg">
            テンションの相談はできますか？
            <span class="text-accent-dark text-2xl ml-4 shrink-0 group-open:rotate-45 transition-transform duration-300">+</span>
          </summary>
          <div class="px-6 pb-6 pt-5 text-text-light leading-relaxed border-t border-line">
            はい、LINEにてお気軽にご相談ください。プレースタイルやラケットに合わせて、1ポンド単位で調整可能です。
          </div>
        </details>
        <details class="bg-white rounded-2xl ring-1 ring-line shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer hover:text-primary transition duration-300 font-bold text-lg">
            御忍庭球塾の会員でなくても利用できますか？
            <span class="text-accent-dark text-2xl ml-4 shrink-0 group-open:rotate-45 transition-transform duration-300">+</span>
          </summary>
          <div class="px-6 pb-6 pt-5 text-text-light leading-relaxed border-t border-line">
            はい、どなたでもご利用いただけます。会員でなくてもお気軽にどうぞ。
          </div>
        </details>
      </div>
    </div>
  </section>
  <section class="closing section-space"><div class="wrap closing-inner"><div><p class="section-label">READY FOR YOUR NEXT GAME</p><h2>張りたての一本で、<br />またコートへ。</h2></div><div class="closing-action"><p>OSHINOBI GUT 24</p><a class="action action-lime" href="https://lin.ee/yLlhrrT" target="_blank" rel="noopener"><TennisIcon name="chat" /> LINEで注文・相談 <TennisIcon name="arrow" /></a><small>JR白石駅北口 徒歩2分 / 24時間ポスト受付<br />完成予定・在庫はLINEでご確認ください。</small></div></div></section>
</div>
</Layout>
