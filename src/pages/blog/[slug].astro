---
import Layout from '../../layouts/Layout.astro';
import { posts, type BlogPost } from '../../data/blog-posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={post.title}>
  <section class="relative py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-dark to-primary"></div>
    <div class="relative max-w-4xl mx-auto px-4 text-center text-white">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full">
          {post.category}
        </span>
        <time class="text-sm text-white/80">{post.date}</time>
      </div>
      <h1 class="text-2xl md:text-3xl font-bold leading-relaxed">{post.title}</h1>
    </div>
  </section>

  <section class="py-16 bg-bg">
    <div class="max-w-3xl mx-auto px-4">
      <article class="bg-white rounded-2xl shadow-sm overflow-hidden">
        {post.image && (
          <div class="w-full aspect-[16/9] bg-gray-100 overflow-hidden">
            <img src={`${base}images/blog/${post.image}`} alt={post.title} class="w-full h-full object-cover" />
          </div>
        )}
        <div class="p-8 md:p-12">
          <div class="prose prose-lg max-w-none text-text leading-relaxed">
            {post.body ? (
              <div set:html={post.body} />
            ) : (
              <p class="text-base">{post.excerpt}</p>
            )}
          </div>

          <div class="mt-12 pt-8 border-t border-gray-100 flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between">
            <a href={`${base}blog`} class="text-sm text-primary font-bold hover:underline">
              ← お知らせ一覧へ戻る
            </a>
            <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="inline-block border border-primary text-primary hover:bg-primary hover:text-white px-6 py-3 text-sm font-bold transition tracking-wider text-center">
              お問い合わせ・体験の申し込み
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>
</Layout>
