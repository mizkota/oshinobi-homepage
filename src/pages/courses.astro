---
import Layout from '../layouts/Layout.astro';
import LessonConsultation from '../components/LessonConsultation.astro';
const base = import.meta.env.BASE_URL;

const courses = [
  { day: '月曜', time1: '19:30〜21:00', level1: 'CD', time2: '21:10〜22:40', level2: 'B' },
  { day: '火曜', time1: '19:30〜21:00', level1: '強化', time2: '21:10〜22:40', level2: 'BC' },
  { day: '水曜', time1: '19:30〜21:00', level1: 'CD', time2: '21:10〜22:40', level2: 'B' },
  { day: '木曜', time1: '19:30〜21:00', level1: 'BC', time2: '21:10〜22:40', level2: 'BC' },
  { day: '金曜', time1: '19:30〜21:00', level1: 'CD', time2: '21:10〜22:40', level2: 'BC' },
];
---

<Layout showFooterCta={false} contactLabel="会員キャンセル待ち" contactUrl="#group-consultation" title="コース・料金システム" description="御忍庭球塾のコース・料金案内。グループ会員はキャンセル待ち受付中。時間割や継続料金を確認して、希望の曜日・時間帯をLINEでお知らせください。">

  <Fragment slot="head">
    <!-- 構造化データ: Service -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "テニスレッスン",
      "provider": {
        "@type": "SportsActivityLocation",
        "name": "御忍庭球塾",
        "url": "https://oshinobitennis.com"
      },
      "areaServed": {
        "@type": "City",
        "name": "札幌市"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "コース・料金",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "グループレッスン（通常期）",
              "description": "定員6名の少人数制レッスン。月曜〜金曜 19:30〜22:40。通常期（5月〜10月）。"
            },
            "price": "12000",
            "priceCurrency": "JPY",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "12000",
              "priceCurrency": "JPY",
              "unitText": "月"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "グループレッスン（冬期）",
              "description": "定員6名の少人数制レッスン。月曜〜金曜 19:30〜22:40。冬期（11月〜4月）。"
            },
            "price": "13000",
            "priceCurrency": "JPY",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "13000",
              "priceCurrency": "JPY",
              "unitText": "月"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "体験レッスン",
              "description": "初回体験レッスン"
            },
            "price": "3000",
            "priceCurrency": "JPY"
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "プライベートレッスン",
              "description": "最大6名まで参加可能。会員でなくても受講可。料金はLINEにて個別にご案内。"
            }
          }
        ]
      }
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="relative py-24 md:py-28 overflow-hidden">
    <div class="absolute inset-0">
      <div class="w-full h-full bg-primary-dark" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-navy-950/85 via-primary-dark/70 to-navy-950/90"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 md:px-6 text-center text-white">
      <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs md:text-sm mb-4">COURSES &amp; PRICE</p>
      <h1 class="text-[clamp(2rem,5vw,3rem)] font-black tracking-tight mb-4">コース・料金システム</h1>
      <div class="w-12 h-0.5 bg-accent mx-auto mb-6"></div>
      <p class="text-white/80 text-lg">入会金無料（2024年11月〜）</p>
    </div>
  </section>

  <!-- Group Lessons -->
  <section id="group-schedule" class="py-20 md:py-24 bg-bg-dark group-information">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-12">
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2">GROUP LESSON</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight">グループレッスン</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
      </div>

      <div class="bg-accent/10 ring-1 ring-accent/30 rounded-2xl p-8 mb-8 text-center">
        <p class="text-xl font-bold text-primary mb-2">グループ会員のキャンセル待ち受付中</p>
        <p class="text-text-light">レギュラー会員枠は現在満員です。入会をご希望の方は、希望の曜日・時間帯とテニス経験をLINEでお知らせください。</p>
        <a href="#group-consultation" class="inline-block mt-4 underline underline-offset-4 font-bold text-primary">会員キャンセル待ちの相談へ →</a>
      </div>
      <!-- 定員説明 -->
      <div class="bg-white rounded-2xl p-6 md:p-8 ring-1 ring-line shadow-sm mb-8">
        <h3 class="font-bold text-lg mb-3">定員について</h3>
        <div class="text-text-light space-y-2 text-sm leading-relaxed">
          <p>各コースの<strong class="text-text">レギュラー会員の定員は6名</strong>です。</p>
          <p>振替受講用に1枠を確保しているため、<strong class="text-text">1レッスンの最大参加人数は7名</strong>になる場合があります。</p>
          <p>少人数制を維持するため、7名を超えることはありません。</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl ring-1 ring-line shadow-sm overflow-hidden mb-8">
        <div class="overflow-x-auto">
          <table class="w-full text-sm lesson-timetable">
            <caption class="sr-only">グループレッスンの時間割</caption>
            <thead class="bg-primary text-white">
              <tr>
                <th scope="col" class="px-6 py-4 text-left font-bold tracking-wider">曜日</th>
                <th scope="col" class="px-6 py-4 text-left font-bold tracking-wider"><span>前半</span> <span class="schedule-time">19:30〜21:00</span></th>
                <th scope="col" class="px-6 py-4 text-left font-bold tracking-wider"><span>後半</span> <span class="schedule-time">21:10〜22:40</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {courses.map((c, i) => (
                <tr class={`${i % 2 === 0 ? 'bg-white' : 'bg-bg'} hover:bg-accent/5 transition duration-300`}>
                  <th scope="row" class="px-6 py-4 font-bold text-left">{c.day}</th>
                  <td class="px-6 py-4">{c.level1}クラス</td>
                  <td class="px-6 py-4">{c.level2}クラス</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-sm text-text-light leading-relaxed mb-8">B・BC・CDなどのクラス選びは、テニス経験と練習したい内容を伺ってご相談いただけます。<a href="#group-consultation" class="underline underline-offset-4 text-primary">自分に合うクラスを相談する →</a></p>


      <!-- Pricing -->

      <p class="font-bold mb-4">現在の料金（2026年12月まで・すべて税込）</p>
      <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <h3 class="font-bold text-lg mb-6 text-center">月会費</h3>
          <div class="space-y-4">
            <div class="flex justify-between items-baseline border-b border-line pb-3">
              <span class="text-text-light">通常期（5月〜10月）</span>
              <span class="text-2xl font-bold text-primary font-display">12,000<span class="text-sm font-normal text-text-light font-sans">円/月</span></span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-text-light">冬期（11月〜4月）</span>
              <span class="text-2xl font-bold text-primary font-display">13,000<span class="text-sm font-normal text-text-light font-sans">円/月</span></span>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <h3 class="font-bold text-lg mb-6 text-center">単発受講</h3>
          <div class="space-y-4">
            <div class="flex justify-between items-baseline border-b border-line pb-3">
              <span class="text-text-light">体験（初回）</span>
              <span class="text-2xl font-bold text-primary font-display">3,000<span class="text-sm font-normal text-text-light font-sans">円/回</span></span>
            </div>
            <div class="flex justify-between items-baseline border-b border-line pb-3">
              <span class="text-text-light">通常期（5月〜10月）</span>
              <span class="text-2xl font-bold text-primary font-display">3,300<span class="text-sm font-normal text-text-light font-sans">円/回</span></span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-text-light">冬期（11月〜4月）</span>
              <span class="text-2xl font-bold text-primary font-display">3,800<span class="text-sm font-normal text-text-light font-sans">円/回</span></span>
            </div>
          </div>
        </div>
      </div>

      <aside class="bg-primary/5 ring-1 ring-primary/20 rounded-2xl p-6 md:p-8 mb-8" aria-labelledby="price-revision-title">
        <p class="text-sm text-text-light mb-2">2026年9月29日 お知らせ</p>
        <h3 id="price-revision-title" class="font-bold text-xl text-primary mb-3">2027年1月からの料金改定について</h3>
        <p class="leading-relaxed mb-3">2026年11月・12月は、従来の冬料金（月会費13,000円）を据え置きます。以下は改定後の料金です。すべて税込です。</p>
        <ul class="list-disc pl-5 space-y-2 leading-relaxed mb-4">
          <li><strong>2027年1月から：</strong>冬の月会費14,000円／単発・冬季4,200円</li>
          <li><strong>2027年1月から：</strong>会員の追加単発は通年3,000円</li>
          <li><strong>2027年5月から：</strong>夏の月会費13,000円／単発・夏季3,800円</li>
        </ul>
        <p class="text-sm text-text-light mb-4">月会費は1か月あたり、単発料金は1回あたりです。改定後は夏季（5〜10月）・冬季（11〜4月）の料金を適用します。</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={`${base}blog/price-revision-2027/`} class="font-bold text-primary underline underline-offset-4">改定の詳しいご案内</a>
          <a href={`${base}documents/price-revision-2027.pdf`} target="_blank" rel="noopener" class="font-bold text-primary underline underline-offset-4">お知らせPDFを開く</a>
        </div>
      </aside>
      <p class="text-sm text-text-light text-center">
        レギュラー定員：各コース6名（+振替枠1名） ／ 会場：PLACE OF SPORTS NEO（デコターフコート）
      </p>
    </div>
  </section>

  <!-- Private Lessons -->
  <section class="py-20 md:py-24 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-12">
        <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2">PRIVATE LESSON</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight">プライベートレッスン</h2>
        <div class="w-12 h-0.5 bg-accent mx-auto mt-4"></div>
      </div>

      <div class="bg-accent/10 ring-1 ring-accent/30 rounded-2xl p-8 mb-8 text-center">
        <p class="text-xl font-bold text-primary mb-2">料金はご希望の時間・内容に応じて個別にご案内いたします</p>
        <p class="text-text-light">希望日・開始時刻・練習時間・人数をお知らせください。</p>
        <a href={`${base}private-lesson#private-consultation`} class="inline-block mt-4 font-bold text-primary underline underline-offset-4">個別レッスンの料金・日時を相談する →</a>
      </div>

      <div class="bg-white rounded-2xl p-8 ring-1 ring-line shadow-sm">
        <h3 class="font-bold text-lg mb-4">プライベートレッスンについて</h3>
        <ul class="text-text-light space-y-3 leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="text-accent-dark font-bold">●</span>
            <span>最大6名まで参加可能</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-accent-dark font-bold">●</span>
            <span>会員でなくても受講可能</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-accent-dark font-bold">●</span>
            <span>コートはお客様にてご手配ください</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-accent-dark font-bold">●</span>
            <span>白石区・中央区在住の方は無料で出張いたします</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-accent-dark font-bold">●</span>
            <span>定期的・継続的にご利用いただく場合は、料金についてご相談を承ります</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-bg-dark"><div class="max-w-5xl mx-auto px-5 md:px-8"><LessonConsultation lesson="group" id="group-consultation" /></div></section>
<section class="py-8 bg-bg"><details class="max-w-4xl mx-auto px-6"><summary class="cursor-pointer py-4 font-medium">チラシでコース案内を見る</summary><img src={`${base}images/courses/flyer.jpg`} alt="コース案内チラシ" loading="lazy" class="w-full max-w-2xl mx-auto" /></details></section>
</Layout>

<style>
  #group-schedule{scroll-margin-top:90px}.lesson-timetable{table-layout:fixed}.lesson-timetable th:first-child{width:20%;white-space:nowrap}.schedule-time{display:inline-block;white-space:nowrap}.group-information .flex.justify-between{flex-wrap:wrap;gap:8px 14px}
  @media(max-width:600px){.lesson-timetable th,.lesson-timetable td{padding:16px 10px;font-size:13px}.lesson-timetable th:first-child{width:18%}.schedule-time{font-size:11px}.group-information .p-8{padding:24px 20px}}
</style>
