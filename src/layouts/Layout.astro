---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '札幌のテニススクール「御忍庭球塾」。少人数制レッスンで、もっと充実したテニスライフを。' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isTop = Astro.url.pathname === base || Astro.url.pathname === '/';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title} | 御忍庭球塾</title>
    <link rel="canonical" href={canonical} />
    {isTop && (
      <>
        <link rel="alternate" hreflang="ja" href="https://oshinobitennis.com/" />
        <link rel="alternate" hreflang="en" href="https://oshinobitennis.com/en/" />
        <link rel="alternate" hreflang="x-default" href="https://oshinobitennis.com/" />
      </>
    )}
    <meta property="og:title" content={`${title} | 御忍庭球塾`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="御忍庭球塾" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content="https://oshinobitennis.com/images/hero/court.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | 御忍庭球塾`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://oshinobitennis.com/images/hero/court.jpg" />
    <slot name="head" />
  </head>
  <body class="bg-white text-text font-sans">
    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-line">
      <div class="max-w-7xl mx-auto px-4 md:px-6 py-2.5 flex items-center justify-between">
        <a href={base} class="flex items-center gap-3 hover:opacity-70 transition duration-300">
          <img src={`${base}images/logo/logo.png`} alt="御忍庭球塾" class="h-12 md:h-14" />
        </a>
        <div class="flex items-center gap-3 md:gap-5">
          <a href={`${base}en`} class="text-sm text-text-light hover:text-primary transition duration-300 font-medium font-display tracking-wide">
            English
          </a>
          <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="hidden md:inline-flex items-center gap-2 rounded-full bg-primary text-white hover:bg-primary-light shadow-lg shadow-primary/20 hover:-translate-y-0.5 px-6 py-2.5 text-sm font-bold transition-all duration-300 tracking-wider">
            お問い合わせ・体験の申し込み
          </a>
          <button id="menu-toggle" class="p-2 flex flex-col gap-1.5" aria-label="メニュー">
            <span class="block w-6 h-0.5 bg-text transition" id="menu-bar-1"></span>
            <span class="block w-6 h-0.5 bg-text transition" id="menu-bar-2"></span>
            <span class="block w-4 h-0.5 bg-text transition ml-auto" id="menu-bar-3"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Fullscreen Menu Overlay -->
    <div id="menu-overlay" class="fixed inset-0 z-40 bg-navy-950/95 backdrop-blur-md hidden opacity-0 transition-opacity duration-500">
      <div class="flex items-center justify-center h-full">
        <nav class="text-center">
          <div class="space-y-8">
            <a href={`${base}courses`} class="block text-white text-2xl font-bold tracking-wider hover:text-accent transition duration-300">コース・料金</a>
            <a href={`${base}private-lesson`} class="block text-white text-2xl font-bold tracking-wider hover:text-accent transition duration-300">プライベートレッスン</a>
            <a href={`${base}gut24`} class="block text-white text-2xl font-bold tracking-wider hover:text-accent transition duration-300">ガット張替</a>
            <a href={`${base}terms`} class="block text-white text-2xl font-bold tracking-wider hover:text-accent transition duration-300">利用規約</a>
            <a href={`${base}blog`} class="block text-white text-2xl font-bold tracking-wider hover:text-accent transition duration-300">お知らせ</a>
            <a href={`${base}en`} class="block text-white text-2xl font-bold tracking-wider hover:text-accent transition duration-300 font-display">English</a>
          </div>
          <div class="mt-12 pt-8 border-t border-white/20">
            <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="rounded-full bg-accent text-primary-dark hover:bg-accent-light font-bold px-10 py-4 transition-all duration-300 inline-block tracking-wider shadow-lg shadow-accent/20 hover:-translate-y-0.5">
              体験のお申し込み
            </a>
          </div>
        </nav>
      </div>
    </div>

    <!-- Spacer for fixed header -->
    <div class="h-[69px] md:h-[77px]"></div>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-navy-950 text-white">
      <!-- CTA Band -->
      <div class="border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="text-center md:text-left">
            <p class="text-accent font-display font-semibold tracking-[0.25em] text-xs mb-2">TRIAL LESSON</p>
            <p class="text-xl md:text-2xl font-black tracking-tight">体験レッスン受付中</p>
          </div>
          <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="rounded-full bg-accent text-primary-dark hover:bg-accent-light font-bold px-10 py-4 transition-all duration-300 inline-block tracking-wider shadow-lg shadow-accent/20 hover:-translate-y-0.5">
            体験のお申し込み
          </a>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 md:px-6 py-20">
        <div class="grid md:grid-cols-3 gap-12 md:gap-16">
          <div>
            <img src={`${base}images/logo/logo.png`} alt="御忍庭球塾" class="h-10 mb-6 brightness-0 invert" />
            <p class="text-sm text-white/50 leading-relaxed">
              札幌市白石区を拠点に活動するテニススクール。<br />
              少人数制で一人ひとりに寄り添ったレッスンを提供しています。
            </p>
          </div>
          <div>
            <h3 class="text-sm font-display font-semibold tracking-[0.25em] text-accent mb-6">LINE</h3>
            <div class="space-y-4 text-sm">
              <a href="https://lin.ee/2CKErIS" target="_blank" rel="noopener" class="flex items-center gap-2 text-white/70 hover:text-accent transition duration-300">
                <span>→</span> レッスンのお問い合わせ
              </a>
              <a href="https://lin.ee/yLlhrrT" target="_blank" rel="noopener" class="flex items-center gap-2 text-white/70 hover:text-accent transition duration-300">
                <span>→</span> ガット張替のお問い合わせ
              </a>
            </div>
          </div>
          <div>
            <h3 class="text-sm font-display font-semibold tracking-[0.25em] text-accent mb-6">LINKS</h3>
            <div class="space-y-4 text-sm">
              <a href="https://www.youtube.com/channel/UCKtgQuL9B0c8y42hHnx8JQQ" target="_blank" rel="noopener" class="flex items-center gap-2 text-white/70 hover:text-accent transition duration-300">
                <span>→</span> YouTube チャンネル
              </a>
              <a href="https://neo-spo.com/" target="_blank" rel="noopener" class="flex items-center gap-2 text-white/70 hover:text-accent transition duration-300">
                <span>→</span> PLACE OF SPORTS NEO
              </a>
            </div>
          </div>
        </div>
        <div class="border-t border-white/10 mt-16 pt-8 text-center text-xs text-white/50 tracking-wider font-display">
          <p>&copy; {new Date().getFullYear()} 御忍庭球塾 All Rights Reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const overlay = document.getElementById('menu-overlay');
      const bar1 = document.getElementById('menu-bar-1');
      const bar2 = document.getElementById('menu-bar-2');
      const bar3 = document.getElementById('menu-bar-3');
      let isOpen = false;

      toggle?.addEventListener('click', () => {
        isOpen = !isOpen;
        if (isOpen) {
          overlay?.classList.remove('hidden');
          requestAnimationFrame(() => {
            overlay?.classList.remove('opacity-0');
            overlay?.classList.add('opacity-100');
          });
          bar1?.classList.add('rotate-45', 'translate-y-[4px]');
          bar2?.classList.add('opacity-0');
          bar3?.classList.add('-rotate-45', '-translate-y-[4px]', 'w-6', 'ml-0');
          document.body.style.overflow = 'hidden';
        } else {
          overlay?.classList.remove('opacity-100');
          overlay?.classList.add('opacity-0');
          setTimeout(() => overlay?.classList.add('hidden'), 500);
          bar1?.classList.remove('rotate-45', 'translate-y-[4px]');
          bar2?.classList.remove('opacity-0');
          bar3?.classList.remove('-rotate-45', '-translate-y-[4px]', 'w-6', 'ml-0');
          document.body.style.overflow = '';
        }
      });

      // Close on link click
      overlay?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          toggle?.click();
        });
      });
    </script>
  </body>
</html>
